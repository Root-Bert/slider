---
import { Avatar } from '@/ui/Avatar';
import Cursor from '~/components/Cursor.astro';
import { asset } from '~/lib/links';
import { person } from '~/lib/people';
import Chapter from './Chapter.astro';
import Draw from './Draw.astro';
import underline from './svg/mark-underline.svg?raw';

/** 08 | Long story short: the chain the thread ends in, signed by the founder. */
const steps = ['Communicate visions.', 'Accelerate society.', 'Build a slower future.'];
---

<Chapter n="08" label="Long story short" pin={false}>
  <div class="relative flex flex-col items-start">
    <!-- The thread from the hero ends here: down the gutter, then right into the first pin. -->
    <span
      class="pointer-events-none absolute right-full bottom-[calc(100%-35px)] hidden h-[6000px] w-[121px] rounded-bl-[12px] border-b-2 border-l-2 border-sage drop-shadow-[0_0_4px_rgb(143_203_155/0.5)] lg:block"
      aria-hidden="true"
      data-thread
    ></span>
    {
      steps.map((step, i) => (
        <>
          <div class="flex items-center gap-4 sm:gap-6" data-reveal style={`--i: ${i}`}>
            <span class="relative size-4 shrink-0">
              <img src={asset('vision/chain-pin.svg')} alt="" class="absolute inset-[-562.5%] block max-w-none" />
            </span>
            <p class="vision-chain text-fg">{step}</p>
          </div>
          <span class="flex pl-[7px]" aria-hidden="true">
            <span class="relative h-9 w-0">
              <img src={asset('vision/chain-connector.svg')} alt="" class="absolute inset-[-2.78%_-1px] block max-w-none" />
            </span>
          </span>
        </>
      ))
    }
    <div class="flex items-center gap-2 sm:gap-3.5" data-reveal style="--i: 3">
      <span class="relative size-4 shrink-0">
        <img src={asset('vision/chain-pin-last.svg')} alt="" class="absolute inset-[-562.5%] block max-w-none" />
      </span>
      <p class="vision-chain">
        <span class="relative inline-block px-[0.16em] pb-[0.03em] text-white">
          Make the world a better place.
          <Draw svg={underline} class="top-[1.004em] left-[0.034em] h-[0.375em] w-[calc(100%-0.034em)]" />
          <Cursor name="Anna" class="absolute top-[0.72em] left-[calc(100%+6px)]" drift />
        </span>
      </p>
    </div>
  </div>
  <div class="flex items-center gap-3 pt-6" data-reveal style="--i: 4">
    <Avatar author={person('Robert')} size={24} nativeTitle={false} />
    <span class="text-[13px] tabular-nums whitespace-pre text-fg-subtle">{'Robert | Founder of Slider'}</span>
  </div>
</Chapter>

<style>
  .vision-chain {
    font-size: clamp(28px, 6.6vw, 64px);
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
</style>
