---
import { Icon } from '@/ui/Icon';
import { Logo } from '@/ui/Logo';
import Button from './Button.astro';
import NavIcon from './NavIcon.astro';
import { localPage, t, type Lang } from '~/i18n';
import { APP_URL, page } from '~/lib/links';

/**
 * Site / Header: logo = home, glass nav pill with the current page selected, login + CTA. Sticky,
 * the pills float over the page. Below md the links sit behind a menu button (no JS to open it).
 */
export type SitePage = 'home' | 'pricing' | 'blog';

interface Props {
  current?: SitePage;
  lang: Lang;
}

const { current, lang } = Astro.props;
const words = t(lang).nav;
/** A pill floating over the page. The header itself lets clicks through around them. */
const float = 'pointer-events-auto bg-glass-elevated ring-1 ring-hairline backdrop-blur-xl';
const nav: { id: SitePage; label: string; href: string }[] = [
  { id: 'home', label: words.home, href: localPage(lang) },
  { id: 'pricing', label: words.pricing, href: localPage(lang, 'pricing') },
  // Posts are English only.
  { id: 'blog', label: words.blog, href: page('blog') },
];
---

<!--
  Nothing behind the bar itself: the page runs on under it and only the pills float, each on its
  own glass, dark (or light) enough to stay readable over any section.
-->
<header class="pointer-events-none sticky top-0 z-(--z-chrome) flex h-18 items-center justify-between px-4 md:px-8">
  <div class="flex items-center lg:w-80">
    <a href={localPage(lang)} aria-label="Slider" class:list={['flex h-11 items-center rounded-panel px-3.5', float]}>
      <Logo />
    </a>
  </div>
  <nav aria-label="Website" class:list={['hidden gap-1 rounded-panel p-1 md:flex', float]}>
    {
      nav.map((item) => (
        <a
          href={item.href}
          aria-current={item.id === current ? 'page' : undefined}
          class:list={[
            'flex items-center gap-2 rounded-control px-4 py-2 text-sm font-medium transition-colors',
            item.id === current ? 'bg-selected text-fg' : 'text-fg-muted hover:bg-hover hover:text-fg',
          ]}
        >
          <NavIcon name={item.id} size={18} active={item.id === current} />
          {item.label}
        </a>
      ))
    }
  </nav>
  <div class="flex items-center justify-end gap-2 lg:w-80">
    <!-- Wrapped: the button's own inline-flex would win over a `hidden` on it. -->
    <span class="hidden md:contents"><Button href={`${APP_URL}/`} variant="ghost" size="md" class={float}>{words.login}</Button></span>
    <Button href={`${APP_URL}/`} size="md" class="pointer-events-auto">{words.start}</Button>
    <details class="site-menu pointer-events-auto relative md:hidden" data-site-menu>
      <summary
        class:list={['flex size-9 cursor-pointer list-none items-center justify-center rounded-control text-fg-muted transition-colors hover:text-fg', float]}
        aria-label={words.menu}
      >
        <Icon name="menu" size={20} className="site-menu-open" />
        <Icon name="close" size={20} className="site-menu-close" />
      </summary>
      <nav aria-label="Website" class="absolute top-12 right-0 flex w-[min(260px,calc(100vw-32px))] flex-col gap-1 rounded-panel bg-glass-solid p-2 shadow-float ring-1 ring-hairline-strong">
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={item.id === current ? 'page' : undefined}
              class:list={[
                'flex items-center gap-3 rounded-control px-3 py-2.5 text-[15px] font-medium transition-colors',
                item.id === current ? 'bg-selected text-fg' : 'text-fg-muted hover:bg-hover hover:text-fg',
              ]}
            >
              <NavIcon name={item.id} size={20} active={item.id === current} />
              {item.label}
            </a>
          ))
        }
        <span class="mx-3 my-1 h-px bg-hairline" aria-hidden="true"></span>
        <a href={`${APP_URL}/`} class="flex items-center gap-3 rounded-control px-3 py-2.5 text-[15px] font-medium text-fg-muted transition-colors hover:bg-hover hover:text-fg">
          <Icon name="arrowForward" size={20} />
          {words.login}
        </a>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-menu summary::-webkit-details-marker {
    display: none;
  }
  .site-menu:not([open]) :global(.site-menu-close),
  .site-menu[open] :global(.site-menu-open) {
    display: none;
  }
  .site-menu[open] summary {
    color: var(--color-fg);
  }
</style>

<script>
  // The menu closes on a tap outside it and on Escape.
  for (const menu of document.querySelectorAll<HTMLDetailsElement>('[data-site-menu]')) {
    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>
