---
import { Icon } from '@/ui/Icon';
import Button from './Button.astro';
import Mark from './Mark.astro';
import { appPage, localPage, s, t, type Lang } from '~/i18n';
import { APP_NAMES, PRODUCTS, type AppId } from '~/lib/apps';
import { APP_URL } from '~/lib/links';

/**
 * Site / Header: a bar across the page that draws in to a floating glass pill once the page scrolls. Left the office (mark and name, its
 * home), beside it the five apps in a row (the one whose page this is picked) and the blog, right
 * login and the call to action in the page's colour. Sticky. Below lg the links sit behind a menu
 * button. Panel and menu open without JS (`<details>`); a script closes them on a click outside.
 */
interface Props {
  /** The office or the app this page belongs to. */
  app: AppId;
  lang: Lang;
}

const { app, lang } = Astro.props;
const words = t(lang).nav;
const suite = s(lang);
const products = PRODUCTS.map((id) => ({
  id,
  label: APP_NAMES[id],
  kind: suite.kinds[id],
  href: appPage(id, lang),
}));
const path = Astro.url.pathname;
const after = [
  { label: suite.nav.blog, href: localPage(lang, 'blog'), current: path.includes('/blog') },
];
const links = after;
const link = 'flex h-9 items-center gap-1 rounded-full px-3 text-[15px] font-medium transition-colors';
const idle = 'text-fg-muted hover:text-fg';
const row = 'flex items-center gap-3 rounded-control px-3 py-2.5 text-[15px] font-medium transition-colors hover:bg-hover';
---

<!--
  One bar floating over the page: glass, round, as wide as the page's content. Around it the
  header lets clicks through, and the page runs on under it.
-->
<header data-site-header class="pointer-events-none sticky top-0 z-(--z-chrome) px-3 pt-3 md:px-6 md:pt-4">
  <div class="site-bar pointer-events-auto mx-auto flex h-14 items-center gap-1 rounded-full pr-2 pl-2.5 md:pl-4">
    <a href={appPage('office', lang)} class="mr-2 flex h-10 items-center gap-2.5 rounded-full pr-3 pl-1.5 text-[17px] font-semibold tracking-[-0.02em] text-fg md:mr-4">
      <Mark app="office" size={24} />
      {APP_NAMES.office}
    </a>
    <nav aria-label={suite.nav.apps} class="hidden items-center gap-1 lg:flex">
      {
        products.map((item) => (
          <a href={item.href} aria-current={item.id === app ? 'page' : undefined} class:list={[link, 'gap-2', item.id === app ? 'bg-selected text-fg' : idle]}>
            <Mark app={item.id} size={18} />
            {item.label}
          </a>
        ))
      }
      <span class="mx-2 h-5 w-px bg-hairline-strong" aria-hidden="true" />
      {
        after.map((item) => (
          <a href={item.href} aria-current={item.current ? 'page' : undefined} class:list={[link, item.current ? 'text-fg' : idle]}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <span class="flex-1"></span>
    <a href={`${APP_URL}/`} class:list={[link, idle, 'hidden md:flex']}>{words.login}</a>
    <Button href={`${APP_URL}/`} size="md">{words.start}</Button>
    <details class="site-menu relative lg:hidden" data-site-menu>
      <summary
        class="flex size-10 cursor-pointer list-none items-center justify-center rounded-full text-fg-muted transition-colors hover:bg-hover hover:text-fg"
        aria-label={words.menu}
      >
        <Icon name="menu" size={20} className="site-menu-open" />
        <Icon name="close" size={20} className="site-menu-close" />
      </summary>
      <nav aria-label={suite.nav.apps} class="absolute top-[calc(100%+14px)] -right-2 flex w-[min(280px,calc(100vw-32px))] flex-col gap-1 rounded-panel bg-glass-solid p-2 shadow-float ring-1 ring-hairline-strong">
        <a href={appPage('office', lang)} aria-current={app === 'office' && !links.some((l) => l.current) ? 'page' : undefined} class:list={[row, idle]}>
          <Mark app="office" size={20} />
          {APP_NAMES.office}
        </a>
        {
          products.map((item) => (
            <a href={item.href} aria-current={item.id === app ? 'page' : undefined} class:list={[row, item.id === app ? 'bg-selected text-fg' : idle]}>
              <Mark app={item.id} size={20} />
              {item.label}
              <small class="ml-auto text-xs font-normal text-fg-subtle">{item.kind}</small>
            </a>
          ))
        }
        <span class="mx-3 my-1 h-px bg-hairline" aria-hidden="true"></span>
        {
          links.map((item) => (
            <a href={item.href} aria-current={item.current ? 'page' : undefined} class:list={[row, item.current ? 'bg-selected text-fg' : idle]}>
              {item.label}
            </a>
          ))
        }
        <span class="mx-3 my-1 h-px bg-hairline" aria-hidden="true"></span>
        <a href={`${APP_URL}/`} class:list={[row, idle]}>
          <Icon name="arrowForward" size={20} />
          {words.login}
        </a>
      </nav>
    </details>
  </div>
</header>

<style>
  /* At the top the bar spans the page and is plain; once the page scrolls it draws in to a glass pill. */
  .site-bar {
    max-width: 100%;
    box-shadow: 0 0 0 1px transparent;
    transition:
      max-width 420ms var(--ease-emphasized),
      background-color 250ms,
      box-shadow 250ms;
  }
  [data-scrolled] .site-bar {
    max-width: 1180px;
    background: var(--color-glass-elevated);
    box-shadow: 0 0 0 1px var(--color-hairline);
    backdrop-filter: blur(24px);
  }
  @media (prefers-reduced-motion: reduce) {
    .site-bar {
      transition: none;
    }
  }
  .site-menu summary::-webkit-details-marker {
    display: none;
  }
  .site-menu:not([open]) :global(.site-menu-close),
  .site-menu[open] :global(.site-menu-open) {
    display: none;
  }
  .site-menu[open] summary {
    color: var(--color-fg);
  }
</style>

<script>
  // The bar is wide at the top of the page and compact once it scrolls.
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const onScroll = (): void => {
    header?.toggleAttribute('data-scrolled', window.scrollY > 24);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Panel and menu close on a click outside them and on Escape.
  for (const menu of document.querySelectorAll<HTMLDetailsElement>('[data-site-menu]')) {
    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>
