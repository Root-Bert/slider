---
import { asset } from '~/lib/links';

/** Figma Site Kit "Slide / Title" (960 × 540), a content mock for product shots. */
---

<div class="bg-[#efe4d2] h-[540px] overflow-clip relative rounded-[4px] w-[960px]">
  <div class="absolute left-[620px] size-[520px] top-[140px]">
    <img alt="" class="absolute block inset-0 max-w-none size-full" src={asset('slides/title/sun.svg')} />
  </div>
  <p class="[word-break:break-word] absolute font-semibold leading-[normal] left-[64px] not-italic text-[#2b1d14] text-[14px] top-[64px] tracking-[1.12px] whitespace-nowrap">
    BOARD REVIEW | OCTOBER 2026
  </p>
  <p class="[word-break:break-word] absolute font-bold leading-[100px] left-[64px] not-italic text-[#2b1d14] text-[96px] top-[330px] tracking-[-3.84px] whitespace-nowrap">
    Q3 Strategy
  </p>
  <p class="[word-break:break-word] absolute font-normal leading-[normal] left-[68px] not-italic text-[#7a6656] text-[24px] top-[440px] whitespace-nowrap">
    Where we grow next
  </p>
  <p class="[word-break:break-word] absolute font-black leading-[normal] left-[760px] not-italic text-[#2b1d14] text-[13px] top-[62px] tracking-[1.56px] whitespace-nowrap">NORTHWIND & CO.</p>
  <div class="absolute bg-[#2b1d14] left-[740px] size-[12px] top-[64px]"></div>
  <p class="[word-break:break-word] absolute font-semibold leading-[normal] left-[64px] not-italic text-[#d35230] text-[13px] top-[296px] tracking-[1.3px] whitespace-nowrap">
    PROJECT MERIDIAN
  </p>
  <div class="absolute bg-[#d35230] h-[3px] left-[64px] top-[286px] w-[40px]"></div>
  <p class="[word-break:break-word] absolute font-normal leading-[normal] left-[64px] not-italic text-[#7a6656] text-[12px] top-[494px] whitespace-pre">Prepared for the Supervisory Board  |  Hamburg, 14 October 2026  |  Draft v4</p>
  <p class="[word-break:break-word] absolute font-normal leading-[normal] left-[64px] not-italic text-[#7a6656] text-[11px] top-[90px] whitespace-nowrap">
    Strictly confidential. For internal discussion only.
  </p>
  <div class="absolute bg-[#f7efe3] h-[112px] left-[686px] rounded-[10px] shadow-[0px_8px_24px_0px_rgba(0,0,0,0.12)] top-[372px] w-[234px]"></div>
  <p class="[word-break:break-word] absolute font-semibold leading-[normal] left-[704px] not-italic text-[#7a6656] text-[10px] top-[388px] tracking-[0.8px] whitespace-nowrap">
    REVENUE 2026E
  </p>
  <p class="[word-break:break-word] absolute font-bold leading-[normal] left-[704px] not-italic text-[#2b1d14] text-[28px] top-[404px] whitespace-nowrap">
    €7.4 M
  </p>
  <p class="[word-break:break-word] absolute font-semibold leading-[normal] left-[704px] not-italic text-[#1f8a4c] text-[11px] top-[442px] whitespace-nowrap">
    ▲ 18% vs. 2025
  </p>
  <p class="[word-break:break-word] absolute font-normal leading-[normal] left-[704px] not-italic text-[#7a6656] text-[10px] top-[460px] whitespace-pre">EBIT margin 12.4%  |  518 customers</p>
  <div class="absolute h-[30px] left-[834px] top-[404px] w-[70px]">
    <img alt="" class="absolute block inset-0 max-w-none size-full" src={asset('slides/title/sparkline.svg')} />
  </div>
</div>
