  <p class="[word-break:break-word] absolute font-semibold leading-[normal] left-[660px] not-italic text-[#1f8a4c] text-[20px] top-[234px] whitespace-nowrap">
    ▲ 5.6%
  </p>
  <div class="absolute h-[20px] left-[800px] top-[236px] w-[60px]">
    <img alt="" class="absolute block inset-0 max-w-none size-full" src={asset('slides/table/sparkline.svg')} />
  </div>
  <p class="[word-break:break-word] absolute font-normal leading-[normal] left-[560px] not-italic text-[#8a877f] text-[20px] top-[298px] whitespace-nowrap">
    500
  </p>
  <p class="[word-break:break-word] absolute font-semibold leading-[normal] left-[660px] not-italic text-[#1f8a4c] text-[20px] top-[298px] whitespace-nowrap">
