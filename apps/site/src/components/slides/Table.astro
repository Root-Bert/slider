---
import { asset } from '~/lib/links';

/** Figma Site Kit "Slide / Table" (960 × 540), a content mock for product shots. */
---

<div class="bg-[#f4f3ee] h-[540px] overflow-clip relative rounded-[4px] w-[960px]">
  <div class="absolute bg-[rgba(211,82,48,0.08)] h-[300px] left-[446px] rounded-[6px] top-[158px] w-[92px]"></div>
  <p class="[word-break:break-word] absolute font-bold leading-[normal] left-[64px] not-italic text-[#141414] text-[44px] top-[64px] tracking-[-0.88px] whitespace-nowrap">
    Numbers at a glance
  </p>
  <p class="[word-break:break-word] absolute font-semibold leading-[normal] left-[64px] not-italic text-[#141414] text-[20px] top-[170px] whitespace-nowrap">
    ​
  </p>
  <p class="[word-break:break-word] absolute font-semibold leading-[normal] left-[260px] not-italic text-[#141414] text-[20px] top-[170px] whitespace-nowrap">
    Q1
  </p>
  <p class="[word-break:break-word] absolute font-semibold leading-[normal] left-[360px] not-italic text-[#141414] text-[20px] top-[170px] whitespace-nowrap">
    Q2
  </p>
  <p class="[word-break:break-word] absolute font-semibold leading-[normal] left-[460px] not-italic text-[#141414] text-[20px] top-[170px] whitespace-nowrap">
