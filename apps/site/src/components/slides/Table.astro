  <div class="absolute bg-[rgba(20,20,20,0.15)] h-px left-[64px] top-[222px] w-[832px]"></div>
  <p class="[word-break:break-word] absolute font-semibold leading-[normal] left-[64px] not-italic text-[#141414] text-[20px] top-[298px] whitespace-nowrap">
