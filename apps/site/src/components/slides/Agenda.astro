---
import { asset } from '~/lib/links';

/** Figma Site Kit "Slide / Agenda" (960 × 540), a content mock for product shots. */
---

<div class="bg-[#f4f3ee] h-[540px] overflow-clip relative rounded-[4px] w-[960px]">
  <div class="absolute bg-white h-[54px] left-[48px] rounded-[10px] top-[330px] w-[560px]"></div>
  <p class="[word-break:break-word] absolute font-bold leading-[normal] left-[64px] not-italic text-[#141414] text-[64px] top-[64px] tracking-[-1.92px] whitespace-nowrap">
    Agenda
  </p>
  <p class="[word-break:break-word] absolute font-semibold leading-[normal] left-[64px] not-italic text-[#d35230] text-[20px] top-[200px] whitespace-nowrap">
    01
  </p>
  <p class="[word-break:break-word] absolute font-medium leading-[normal] left-[130px] not-italic text-[#141414] text-[28px] top-[195px] whitespace-nowrap">
    Where we stand
  </p>
  <p class="[word-break:break-word] absolute font-semibold leading-[normal] left-[64px] not-italic text-[#d35230] text-[20px] top-[272px] whitespace-nowrap">
    02
  </p>
  <p class="[word-break:break-word] absolute font-medium leading-[normal] left-[130px] not-italic text-[#141414] text-[28px] top-[267px] whitespace-nowrap">
    What customers say
  </p>
  <p class="[word-break:break-word] absolute font-semibold leading-[normal] left-[64px] not-italic text-[#d35230] text-[20px] top-[344px] whitespace-nowrap">
    03
  </p>
  <p class="[word-break:break-word] absolute font-medium leading-[normal] left-[130px] not-italic text-[#141414] text-[28px] top-[339px] whitespace-nowrap">
    Growth plan Q4
  </p>
  <p class="[word-break:break-word] absolute font-semibold leading-[normal] left-[64px] not-italic text-[#d35230] text-[20px] top-[416px] whitespace-nowrap">
    04
  </p>
  <p class="[word-break:break-word] absolute font-medium leading-[normal] left-[130px] not-italic text-[#141414] text-[28px] top-[411px] whitespace-nowrap">Budget & next steps</p>
  <div class="absolute bg-[#0b2545] left-[640px] rounded-[14px] size-[260px] top-[200px]"></div>
  <div class="absolute h-[0.01px] left-[64px] top-[232px] w-px"></div>
  <p class="[word-break:break-word] absolute font-normal leading-[normal] left-[430px] not-italic text-[#5a5a5a] text-[13px] top-[201px] whitespace-pre">09:00  |  15 min</p>
  <p class="[word-break:break-word] absolute font-semibold leading-[normal] left-[560px] not-italic text-[#141414] text-[13px] top-[201px] whitespace-nowrap">
    Marcel
  </p>
  <p class="[word-break:break-word] absolute font-normal leading-[normal] left-[430px] not-italic text-[#5a5a5a] text-[13px] top-[273px] whitespace-pre">09:15  |  25 min</p>
  <p class="[word-break:break-word] absolute font-semibold leading-[normal] left-[560px] not-italic text-[#141414] text-[13px] top-[273px] whitespace-nowrap">
    Flo
  </p>
  <p class="[word-break:break-word] absolute font-normal leading-[normal] left-[430px] not-italic text-[#5a5a5a] text-[13px] top-[345px] whitespace-pre">09:40  |  30 min</p>
  <p class="[word-break:break-word] absolute font-semibold leading-[normal] left-[560px] not-italic text-[#141414] text-[13px] top-[345px] whitespace-nowrap">
    Albert
  </p>
  <p class="[word-break:break-word] absolute font-normal leading-[normal] left-[430px] not-italic text-[#5a5a5a] text-[13px] top-[417px] whitespace-pre">10:10  |  20 min</p>
  <p class="[word-break:break-word] absolute font-semibold leading-[normal] left-[560px] not-italic text-[#141414] text-[13px] top-[417px] whitespace-nowrap">
    Gesa
  </p>
  <p class="[word-break:break-word] absolute font-bold leading-[normal] left-[380px] not-italic text-[#d35230] text-[10px] top-[349px] tracking-[1px] whitespace-nowrap">
    NOW
  </p>
  <div class="absolute bg-[#d9d6cc] h-[4px] left-[64px] rounded-[2px] top-[474px] w-[544px]"></div>
  <div class="absolute bg-[#d35230] h-[4px] left-[64px] rounded-[2px] top-[474px] w-[300px]"></div>
  <p class="[word-break:break-word] absolute font-normal leading-[normal] left-[64px] not-italic text-[#8a877f] text-[11px] top-[486px] whitespace-nowrap">
    55 of 90 min used
  </p>
  <p class="-translate-x-full [word-break:break-word] absolute font-normal leading-[normal] left-[900px] not-italic text-[#8a877f] text-[11px] text-right top-[500px] w-[20px]">
    2
  </p>
  <p class="[word-break:break-word] absolute font-semibold leading-[normal] left-[664px] not-italic text-[10px] text-[rgba(255,255,255,0.6)] top-[222px] tracking-[1px] whitespace-nowrap">
    BOARD MEETING
  </p>
  <p class="[word-break:break-word] absolute font-semibold leading-[normal] left-[664px] not-italic text-[13px] text-white top-[240px] whitespace-pre">Tue, 14 Oct  |  09:00 to 10:30</p>
  <p class="[word-break:break-word] absolute font-normal leading-[normal] left-[664px] not-italic text-[11px] text-[rgba(255,255,255,0.7)] top-[260px] whitespace-nowrap">
    Room Elbe, 4th floor + Slider link
  </p>
  <div class="absolute bg-[rgba(255,255,255,0.2)] h-px left-[664px] top-[286px] w-[212px]"></div>
  <p class="[word-break:break-word] absolute font-bold leading-[normal] left-[664px] not-italic text-[15px] text-white top-[298px] whitespace-nowrap">
    3 decisions needed
  </p>
  <div class="absolute left-[666px] size-[6px] top-[330px]">
    <img alt="" class="absolute block inset-0 max-w-none size-full" src={asset('slides/agenda/dot.svg')} />
  </div>
  <p class="[word-break:break-word] absolute font-normal leading-[normal] left-[680px] not-italic text-[12px] text-white top-[325px] whitespace-nowrap">
    Release Q4 budget
  </p>
  <div class="absolute left-[666px] size-[6px] top-[352px]">
    <img alt="" class="absolute block inset-0 max-w-none size-full" src={asset('slides/agenda/dot.svg')} />
  </div>
  <p class="[word-break:break-word] absolute font-normal leading-[normal] left-[680px] not-italic text-[12px] text-white top-[347px] whitespace-nowrap">
    Hiring plan EU
  </p>
  <div class="absolute left-[666px] size-[6px] top-[374px]">
    <img alt="" class="absolute block inset-0 max-w-none size-full" src={asset('slides/agenda/dot.svg')} />
  </div>
  <p class="[word-break:break-word] absolute font-normal leading-[normal] left-[680px] not-italic text-[12px] text-white top-[369px] whitespace-nowrap">
    Pricing change
  </p>
  <div class="absolute left-[664px] size-[24px] top-[410px]">
    <img alt="" class="absolute block inset-0 max-w-none size-full" src={asset('slides/agenda/dot1.svg')} />
  </div>
  <div class="absolute left-[680px] size-[24px] top-[410px]">
    <img alt="" class="absolute block inset-0 max-w-none size-full" src={asset('slides/agenda/dot2.svg')} />
  </div>
  <div class="absolute left-[696px] size-[24px] top-[410px]">
    <img alt="" class="absolute block inset-0 max-w-none size-full" src={asset('slides/agenda/dot3.svg')} />
  </div>
  <div class="absolute left-[712px] size-[24px] top-[410px]">
    <img alt="" class="absolute block inset-0 max-w-none size-full" src={asset('slides/agenda/dot4.svg')} />
  </div>
  <p class="[word-break:break-word] absolute font-normal leading-[normal] left-[736px] not-italic text-[11px] text-[rgba(255,255,255,0.7)] top-[414px] whitespace-nowrap">
    +5 attending
  </p>
</div>
