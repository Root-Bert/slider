---
import './fonts.css';
import { asset } from '~/lib/links';

/** Figma Site Kit "Slide / Lecture" (960 × 540), a content mock for product shots. */
---

<div class="bg-[#fffdf8] h-[540px] overflow-clip relative w-[960px]">
  <div class="absolute bg-[#7a1e2c] h-[44px] left-0 top-0 w-[960px]"></div>
  <p class="[word-break:break-word] absolute font-[IBM_Plex_Sans] font-semibold leading-[normal] left-[32px] text-[12px] text-white top-[13px] tracking-[1.2px] whitespace-nowrap">
    NORDSTADT UNIVERSITY
  </p>
  <p class="[word-break:break-word] absolute font-[IBM_Plex_Sans] font-normal leading-[normal] left-[214px] text-[11px] text-[rgba(255,255,255,0.75)] top-[14px] whitespace-nowrap">
    Faculty of Business, Economics and Social Sciences
  </p>
  <p class="-translate-x-full [word-break:break-word] absolute font-[IBM_Plex_Sans] font-normal leading-[normal] left-[928px] text-[11px] text-[rgba(255,255,255,0.75)] text-right top-[14px] w-[328px] whitespace-pre-wrap">Macroeconomics II  |  Prof. Dr. M. Weber  |  WS 2026/27</p>
  <p class="[word-break:break-word] absolute font-[IBM_Plex_Sans] font-medium leading-[normal] left-[32px] text-[#7a1e2c] text-[12px] top-[64px] whitespace-nowrap">
    Lecture 7: The IS-LM model
  </p>
  <p class="[word-break:break-word] absolute font-[Libertinus_Serif] font-bold leading-[normal] left-[32px] not-italic text-[#1a1a1a] text-[30px] top-[82px] whitespace-pre">7.3  Equilibrium in goods and money markets</p>
  <p class="[word-break:break-word] absolute font-[Libertinus_Serif] font-bold leading-[normal] left-[32px] not-italic text-[#1a1a1a] text-[16px] top-[140px] whitespace-nowrap">
    IS curve (goods market)
  </p>
  <p class="[word-break:break-word] absolute font-[Libertinus_Serif] italic leading-[normal] left-[48px] text-[#1a1a1a] text-[21px] top-[164px] whitespace-nowrap">
    Y = C(Y − T) + I(Y, i) + G
  </p>
  <p class="[word-break:break-word] absolute font-[Libertinus_Serif] font-bold leading-[normal] left-[32px] not-italic text-[#1a1a1a] text-[16px] top-[206px] whitespace-nowrap">
    LM curve (money market)
  </p>
  <p class="[word-break:break-word] absolute font-[Libertinus_Serif] italic leading-[normal] left-[48px] text-[#1a1a1a] text-[21px] top-[230px] whitespace-nowrap">
    M / P = Y · L(i)
  </p>
  <p class="[word-break:break-word] absolute font-[Libertinus_Serif] leading-[normal] left-[36px] not-italic text-[#7a1e2c] text-[16px] top-[276px] whitespace-nowrap">
    •
  </p>
  <p class="[word-break:break-word] absolute font-[Libertinus_Serif] leading-[0] left-[52px] not-italic text-[#1a1a1a] text-[15px] top-[276px] w-[400px]">
    <span class="font-[Libertinus_Serif] font-semibold leading-[1.18]">Fiscal expansion (G ↑) shifts IS to the right:</span>
    <span class="leading-[1.18]"> Y ↑ and i ↑, private investment is partly crowded out.</span>
  </p>
  <p class="[word-break:break-word] absolute font-[Libertinus_Serif] leading-[normal] left-[36px] not-italic text-[#7a1e2c] text-[16px] top-[320px] whitespace-nowrap">
    •
  </p>
  <p class="[word-break:break-word] absolute font-[Libertinus_Serif] leading-[0] left-[52px] not-italic text-[#1a1a1a] text-[15px] top-[320px] w-[400px]">
    <span class="font-[Libertinus_Serif] font-semibold leading-[1.18]">Monetary expansion (M ↑) shifts LM down:</span>
    <span class="leading-[1.18]"> Y ↑ and i ↓.</span>
  </p>
  <p class="[word-break:break-word] absolute font-[Libertinus_Serif] leading-[normal] left-[36px] not-italic text-[#7a1e2c] text-[16px] top-[364px] whitespace-nowrap">
    •
  </p>
  <p class="[word-break:break-word] absolute font-[Libertinus_Serif] leading-[0] left-[52px] not-italic text-[#1a1a1a] text-[15px] top-[364px] w-[400px]">
    <span class="font-[Libertinus_Serif] font-semibold leading-[1.18]">A policy mix can raise output</span>
    <span class="leading-[1.18]"> while keeping the interest rate constant.</span>
  </p>
  <div class="absolute bg-[#f7edee] h-[64px] left-[32px] rounded-[4px] top-[416px] w-[430px]"></div>
  <div class="absolute bg-[#7a1e2c] h-[64px] left-[32px] top-[416px] w-[3px]"></div>
  <p class="[word-break:break-word] absolute font-[IBM_Plex_Sans] font-semibold leading-[normal] left-[46px] text-[#7a1e2c] text-[11px] top-[424px] whitespace-nowrap">
    Exam tip
  </p>
  <p class="[word-break:break-word] absolute font-[Libertinus_Serif] leading-[1.18] left-[46px] not-italic text-[#1a1a1a] text-[13px] top-[442px] w-[400px]">
    Always say which curve shifts and why, then label the new equilibrium E′ and both axes.
  </p>
  <div class="absolute h-[330px] left-[520px] top-[120px] w-[400px]">
