---
import './fonts.css';
import { asset } from '~/lib/links';

/** Figma Site Kit "Slide / Matrix" (960 × 540), a content mock for product shots. */
---

<div class="bg-[#0a1f44] h-[540px] overflow-clip relative w-[960px]">
  <div class="absolute bg-[#13305f] h-[22px] left-[40px] rounded-[3px] top-[24px] w-[112px]"></div>
  <p class="-translate-x-1/2 [word-break:break-word] absolute font-[IBM_Plex_Sans] font-normal leading-[normal] left-[96px] text-[#a5b4cf] text-[10px] text-center top-[28px] w-[112px]">
    Diagnosis
  </p>
  <div class="absolute bg-[#13305f] h-[22px] left-[158px] rounded-[3px] top-[24px] w-[112px]"></div>
  <p class="-translate-x-1/2 [word-break:break-word] absolute font-[IBM_Plex_Sans] font-normal leading-[normal] left-[214px] text-[#a5b4cf] text-[10px] text-center top-[28px] w-[112px]">
    Options
  </p>
  <div class="absolute bg-[#f8fafc] h-[22px] left-[276px] rounded-[3px] top-[24px] w-[112px]"></div>
  <p class="-translate-x-1/2 [word-break:break-word] absolute font-[IBM_Plex_Sans] font-semibold leading-[normal] left-[332px] text-[10px] text-center text-white top-[28px] w-[112px]">
    Recommendation
  </p>
  <div class="absolute bg-[#13305f] h-[22px] left-[394px] rounded-[3px] top-[24px] w-[112px]"></div>
  <p class="-translate-x-1/2 [word-break:break-word] absolute font-[IBM_Plex_Sans] font-normal leading-[normal] left-[450px] text-[#a5b4cf] text-[10px] text-center top-[28px] w-[112px]">
    Roadmap
  </p>
  <div class="absolute border border-[#b45309] border-solid h-[22px] left-[826px] rounded-[3px] top-[24px] w-[94px]"></div>
  <p class="-translate-x-1/2 [word-break:break-word] absolute font-[IBM_Plex_Sans] font-semibold leading-[normal] left-[873px] text-[#b45309] text-[9px] text-center top-[28px] tracking-[0.54px] w-[94px]">
    PRELIMINARY
  </p>
  <p class="[word-break:break-word] absolute font-[IBM_Plex_Serif] font-semibold leading-[1.2] left-[40px] not-italic text-[#f8fafc] text-[21px] top-[60px] w-[880px]">
    Three of nine product lines create 80% of value: shift investment to the upper right and fix or exit Contract Services
  </p>
  <div class="absolute bg-[#13305f] h-[165px] left-[90px] top-[130px] w-[210px]"></div>
  <div class="absolute bg-[#13305f] h-[165px] left-[300px] top-[130px] w-[210px]"></div>
  <div class="absolute bg-[#13305f] h-[165px] left-[90px] top-[295px] w-[210px]"></div>
  <div class="absolute bg-[#13305f] h-[165px] left-[300px] top-[295px] w-[210px]"></div>
  <div class="absolute border border-[#2a4a7f] border-solid h-[330px] left-[90px] top-[130px] w-[420px]"></div>
  <div class="absolute bg-[#2a4a7f] h-[330px] left-[300px] top-[130px] w-px"></div>
  <div class="absolute bg-[#2a4a7f] h-px left-[90px] top-[295px] w-[420px]"></div>
  <p class="[word-break:break-word] absolute font-[IBM_Plex_Sans] font-semibold leading-[normal] left-[98px] text-[#a5b4cf] text-[9px] top-[138px] tracking-[0.54px] whitespace-nowrap">
    SELECTIVELY GROW
  </p>
  <p class="-translate-x-full [word-break:break-word] absolute font-[IBM_Plex_Sans] font-semibold leading-[normal] left-[502px] text-[#0f766e] text-[9px] text-right top-[138px] tracking-[0.54px] w-[102px]">
    INVEST AND GROW
  </p>
  <p class="[word-break:break-word] absolute font-[IBM_Plex_Sans] font-semibold leading-[normal] left-[98px] text-[#f8fafc] text-[9px] top-[442px] tracking-[0.54px] whitespace-nowrap">
    FIX OR EXIT
  </p>
  <p class="-translate-x-full [word-break:break-word] absolute font-[IBM_Plex_Sans] font-semibold leading-[normal] left-[502px] text-[#a5b4cf] text-[9px] text-right top-[442px] tracking-[0.54px] w-[102px]">
    HARVEST
  </p>
  <div class="absolute h-[12px] left-[90px] top-[466px] w-[430px]">
    <img alt="" class="absolute block inset-0 max-w-none size-full" src={asset('slides/matrix/x-axis.svg')} />
  </div>
  <p class="[word-break:break-word] absolute font-[IBM_Plex_Sans] font-normal leading-[normal] left-[200px] text-[#f8fafc] text-[11px] top-[480px] whitespace-nowrap">
    Market attractiveness (growth, margin pool)
  </p>
  <div class="absolute h-[340px] left-[70px] top-[122px] w-[12px]">
    <img alt="" class="absolute block inset-0 max-w-none size-full" src={asset('slides/matrix/y-axis.svg')} />
  </div>
  <div class="absolute flex h-[102px] items-center justify-center left-[44px] top-[253px] w-[14px]">
    <div class="-rotate-90 flex-none">
      <p class="[word-break:break-word] font-[IBM_Plex_Sans] font-normal leading-[normal] relative text-[#f8fafc] text-[11px] whitespace-nowrap">
        Competitive position
      </p>
    </div>
  </div>
  <p class="[word-break:break-word] absolute font-[IBM_Plex_Sans] font-semibold leading-[normal] left-[560px] text-[#f8fafc] text-[13px] top-[132px] whitespace-nowrap">
    Recommendation
  </p>
  <div class="absolute left-[560px] size-[24px] top-[156px]">
    <img alt="" class="absolute block inset-0 max-w-none size-full" src={asset('slides/matrix/dot.svg')} />
  </div>
  <p class="-translate-x-1/2 [word-break:break-word] absolute font-[IBM_Plex_Sans] font-bold leading-[normal] left-[572px] text-[12px] text-center text-white top-[160px] w-[24px]">
    1
  </p>
  <p class="[word-break:break-word] absolute font-[IBM_Plex_Sans] font-semibold leading-[1.25] left-[596px] text-[#f8fafc] text-[13px] top-[156px] w-[320px]">
    Double down on Cloud platform and Analytics.
  </p>
  <p class="[word-break:break-word] absolute font-[IBM_Plex_Sans] font-normal leading-[1.3] left-[596px] text-[#a5b4cf] text-[11px] top-[192px] w-[320px]">
    Together 54% of revenue, 71% of EBIT. Add €18 M capex.
  </p>
  <div class="absolute left-[560px] size-[24px] top-[228px]">
    <img alt="" class="absolute block inset-0 max-w-none size-full" src={asset('slides/matrix/dot.svg')} />
  </div>
  <p class="-translate-x-1/2 [word-break:break-word] absolute font-[IBM_Plex_Sans] font-bold leading-[normal] left-[572px] text-[12px] text-center text-white top-[232px] w-[24px]">
    2
  </p>
  <p class="[word-break:break-word] absolute font-[IBM_Plex_Sans] font-semibold leading-[1.25] left-[596px] text-[#f8fafc] text-[13px] top-[228px] w-[320px]">
    Move Integration into the upper right.
  </p>
  <p class="[word-break:break-word] absolute font-[IBM_Plex_Sans] font-normal leading-[1.3] left-[596px] text-[#a5b4cf] text-[11px] top-[264px] w-[320px]">
    Bundle with Cloud, target 15% margin by 2028.
  </p>
  <div class="absolute left-[560px] size-[24px] top-[300px]">
    <img alt="" class="absolute block inset-0 max-w-none size-full" src={asset('slides/matrix/dot.svg')} />
  </div>
  <p class="-translate-x-1/2 [word-break:break-word] absolute font-[IBM_Plex_Sans] font-bold leading-[normal] left-[572px] text-[12px] text-center text-white top-[304px] w-[24px]">
    3
  </p>
  <p class="[word-break:break-word] absolute font-[IBM_Plex_Sans] font-semibold leading-[1.25] left-[596px] text-[#f8fafc] text-[13px] top-[300px] w-[320px]">
    Fix or exit Contract Services.
  </p>
  <p class="[word-break:break-word] absolute font-[IBM_Plex_Sans] font-normal leading-[1.3] left-[596px] text-[#a5b4cf] text-[11px] top-[336px] w-[320px]">
    −6% margin, no path to scale. Decide by Q1 2027.
  </p>
  <div class="absolute bg-[#13305f] h-[78px] left-[560px] rounded-[6px] top-[382px] w-[360px]"></div>
  <div class="absolute bg-[#0f766e] h-[78px] left-[560px] top-[382px] w-[3px]"></div>
  <p class="[word-break:break-word] absolute font-[IBM_Plex_Sans] font-semibold leading-[normal] left-[576px] text-[#0f766e] text-[9px] top-[392px] tracking-[0.54px] whitespace-nowrap">
    IMPACT BY 2028
  </p>
  <p class="[word-break:break-word] absolute font-[IBM_Plex_Sans] font-bold leading-[normal] left-[576px] text-[#f8fafc] text-[20px] top-[408px] whitespace-nowrap">
    +€42 M
  </p>
  <p class="[word-break:break-word] absolute font-[IBM_Plex_Sans] font-normal leading-[normal] left-[576px] text-[#a5b4cf] text-[10px] top-[436px] whitespace-nowrap">
    EBIT
  </p>
  <p class="[word-break:break-word] absolute font-[IBM_Plex_Sans] font-bold leading-[normal] left-[688px] text-[#f8fafc] text-[20px] top-[408px] whitespace-nowrap">
    +3.1 pp
  </p>
  <p class="[word-break:break-word] absolute font-[IBM_Plex_Sans] font-normal leading-[normal] left-[688px] text-[#a5b4cf] text-[10px] top-[436px] whitespace-nowrap">
    margin
  </p>
  <p class="[word-break:break-word] absolute font-[IBM_Plex_Sans] font-bold leading-[normal] left-[800px] text-[#f8fafc] text-[20px] top-[408px] whitespace-nowrap">
    €18 M
  </p>
  <p class="[word-break:break-word] absolute font-[IBM_Plex_Sans] font-normal leading-[normal] left-[800px] text-[#a5b4cf] text-[10px] top-[436px] whitespace-nowrap">
    capex
  </p>
  <div class="absolute bg-[#2a4a7f] h-px left-[40px] top-[494px] w-[880px]"></div>
  <p class="[word-break:break-word] absolute font-[IBM_Plex_Sans] font-normal leading-[normal] left-[40px] text-[#a5b4cf] text-[9px] top-[504px] whitespace-nowrap">
    Source: segment reporting FY2025, market model (n = 9 product lines), expert interviews (n = 23). Positions as of 30 Sep 2026.
  </p>
  <p class="-translate-x-full [word-break:break-word] absolute font-[IBM_Plex_Sans] font-semibold leading-[normal] left-[920px] text-[#f8fafc] text-[9px] text-right top-[504px] w-[40px]">
    11
  </p>
  <div class="absolute h-[56px] left-[338px] top-[258px] w-[80px]">
    <img alt="" class="absolute block inset-0 max-w-none size-full" src={asset('slides/matrix/move-arrow.svg')} />
  </div>
  <div class="absolute left-[352px] size-[76px] top-[164px]">
    <img alt="" class="absolute block inset-0 max-w-none size-full" src={asset('slides/matrix/bubble-cloud-platform.svg')} />
  </div>
  <p class="[word-break:break-word] absolute font-[IBM_Plex_Sans] font-medium leading-[normal] left-[277px] text-[#f8fafc] text-[10px] top-[195px] whitespace-nowrap">
    Cloud platform
  </p>
  <div class="absolute left-[454px] size-[40px] top-[172px]">
    <img alt="" class="absolute block inset-0 max-w-none size-full" src={asset('slides/matrix/bubble-managed-security.svg')} />
  </div>
  <p class="[word-break:break-word] absolute font-[IBM_Plex_Sans] font-medium leading-[normal] left-[433.5px] text-[#f8fafc] text-[10px] top-[214px] whitespace-nowrap">
    Managed security
  </p>
  <div class="absolute left-[414px] size-[56px] top-[254px]">
    <img alt="" class="absolute block inset-0 max-w-none size-full" src={asset('slides/matrix/bubble-analytics.svg')} />
  </div>
  <p class="[word-break:break-word] absolute font-[IBM_Plex_Sans] font-medium leading-[normal] left-[420.5px] text-[#f8fafc] text-[10px] top-[312px] whitespace-nowrap">
    Analytics
  </p>
  <div class="absolute left-[216px] size-[48px] top-[198px]">
    <img alt="" class="absolute block inset-0 max-w-none size-full" src={asset('slides/matrix/bubble-field-service-app.svg')} />
  </div>
  <p class="[word-break:break-word] absolute font-[IBM_Plex_Sans] font-medium leading-[normal] left-[201px] text-[#f8fafc] text-[10px] top-[248px] whitespace-nowrap">
    Field service app
  </p>
  <div class="absolute left-[298px] size-[48px] top-[306px]">
    <img alt="" class="absolute block inset-0 max-w-none size-full" src={asset('slides/matrix/bubble-field-service-app.svg')} />
  </div>
  <p class="[word-break:break-word] absolute font-[IBM_Plex_Sans] font-medium leading-[normal] left-[296px] text-[#f8fafc] text-[10px] top-[356px] whitespace-nowrap">
    Integration
  </p>
  <div class="absolute left-[382px] size-[56px] top-[354px]">
    <img alt="" class="absolute block inset-0 max-w-none size-full" src={asset('slides/matrix/bubble-legacy-hosting.svg')} />
  </div>
  <p class="[word-break:break-word] absolute font-[IBM_Plex_Sans] font-medium leading-[normal] left-[376px] text-[#f8fafc] text-[10px] top-[412px] whitespace-nowrap">
    Legacy hosting
  </p>
  <div class="absolute left-[220px] size-[40px] top-[320px]">
    <img alt="" class="absolute block inset-0 max-w-none size-full" src={asset('slides/matrix/bubble-licences.svg')} />
  </div>
  <p class="[word-break:break-word] absolute font-[IBM_Plex_Sans] font-medium leading-[normal] left-[220px] text-[#f8fafc] text-[10px] top-[362px] whitespace-nowrap">
    Licences
  </p>
  <div class="absolute left-[140px] size-[56px] top-[354px]">
    <img alt="" class="absolute block inset-0 max-w-none size-full" src={asset('slides/matrix/bubble-contract-services.svg')} />
  </div>
  <p class="[word-break:break-word] absolute font-[IBM_Plex_Sans] font-medium leading-[normal] left-[128px] text-[#f8fafc] text-[10px] top-[412px] whitespace-nowrap">
    Contract services
  </p>
  <div class="absolute left-[272px] size-[28px] top-[412px]">
    <img alt="" class="absolute block inset-0 max-w-none size-full" src={asset('slides/matrix/bubble-training.svg')} />
  </div>
  <p class="[word-break:break-word] absolute font-[IBM_Plex_Sans] font-medium leading-[normal] left-[305px] text-[#f8fafc] text-[10px] top-[419px] whitespace-nowrap">
    Training
  </p>
</div>
