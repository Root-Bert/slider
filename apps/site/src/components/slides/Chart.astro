---
import { asset } from '~/lib/links';

/** Figma Site Kit "Slide / Chart" (960 × 540), a content mock for product shots. */
---

<div class="bg-[#141416] h-[540px] overflow-clip relative rounded-[4px] w-[960px]">
  <p class="[word-break:break-word] absolute font-semibold leading-[normal] left-[64px] not-italic text-[#f4f4f5] text-[14px] top-[64px] tracking-[1.12px] whitespace-nowrap">
    02 | GROWTH
  </p>
  <div class="[word-break:break-word] absolute font-bold leading-[0] left-[64px] not-italic text-[#f4f4f5] text-[52px] top-[110px] tracking-[-1.56px] whitespace-nowrap">
    <p class="leading-[56px] mb-0">Growth without</p>
    <p class="leading-[56px]">the noise.</p>
  </div>
  <div class="[word-break:break-word] absolute font-normal leading-[0] left-[64px] not-italic text-[#a1a1aa] text-[18px] top-[380px] whitespace-nowrap">
    <p class="leading-[28px] mb-0">Recurring revenue grew in every quarter.</p>
    <p class="leading-[28px]">Q4 is planned with a stronger product mix.</p>
  </div>
  <div class="absolute h-[330px] left-[520px] top-[120px] w-[380px]">
    <div class="absolute bg-[#34343a] h-px left-0 top-[58.4px] w-[380px]"></div>
    <div class="absolute bg-[#34343a] h-px left-0 top-[118.8px] w-[380px]"></div>
    <div class="absolute bg-[#34343a] h-px left-0 top-[179.2px] w-[380px]"></div>
    <div class="absolute bg-[#34343a] h-px left-0 top-[239.6px] w-[380px]"></div>
    <div class="absolute bg-[#f4f4f5] h-[120px] left-[20px] rounded-[4px] top-[180px] w-[64px]"></div>
    <div class="absolute bg-[#f4f4f5] h-[170px] left-[112px] rounded-[4px] top-[130px] w-[64px]"></div>
    <div class="absolute bg-[#f4f4f5] h-[215px] left-[204px] rounded-[4px] top-[85px] w-[64px]"></div>
    <div class="absolute bg-[#0048ff] h-[290px] left-[296px] rounded-[4px] top-[10px] w-[64px]"></div>
    <div class="absolute bg-[rgba(244,244,245,0.2)] h-[2px] left-0 top-[300px] w-[380px]"></div>
    <p class="[word-break:break-word] absolute font-medium leading-[normal] left-[42px] not-italic text-[#a1a1aa] text-[14px] top-[310px] whitespace-nowrap">
      Q1
    </p>
    <p class="[word-break:break-word] absolute font-medium leading-[normal] left-[134px] not-italic text-[#a1a1aa] text-[14px] top-[310px] whitespace-nowrap">
      Q2
    </p>
    <p class="[word-break:break-word] absolute font-medium leading-[normal] left-[226px] not-italic text-[#a1a1aa] text-[14px] top-[310px] whitespace-nowrap">
      Q3
    </p>
    <p class="[word-break:break-word] absolute font-medium leading-[normal] left-[318px] not-italic text-[#a1a1aa] text-[14px] top-[310px] whitespace-nowrap">
      Q4
    </p>
    <p class="-translate-x-1/2 [word-break:break-word] absolute font-semibold leading-[normal] left-[52px] not-italic text-[#f4f4f5] text-[12px] text-center top-[162px] w-[64px]">
      1.0
    </p>
    <p class="-translate-x-1/2 [word-break:break-word] absolute font-semibold leading-[normal] left-[144px] not-italic text-[#f4f4f5] text-[12px] text-center top-[112px] w-[64px]">
      1.4
    </p>
    <p class="-translate-x-1/2 [word-break:break-word] absolute font-semibold leading-[normal] left-[236px] not-italic text-[#f4f4f5] text-[12px] text-center top-[67px] w-[64px]">
      1.8
    </p>
    <p class="-translate-x-1/2 [word-break:break-word] absolute font-semibold leading-[normal] left-[328px] not-italic text-[#0048ff] text-[12px] text-center top-[-8px] w-[64px]">
      2.4
    </p>
    <p class="-translate-x-1/2 [word-break:break-word] absolute font-semibold leading-[normal] left-[328px] not-italic text-[8px] text-center text-white top-[276px] w-[64px]">
      PLAN
    </p>
    <div class="absolute h-[170px] left-[30px] top-[-6px] w-[300px]">
      <img alt="" class="absolute block inset-0 max-w-none size-full" src={asset('slides/chart/cagr-arrow.svg')} />
    </div>
  </div>
  <p class="-translate-x-full [word-break:break-word] absolute font-normal leading-[normal] left-[514px] not-italic text-[#a1a1aa] text-[10px] text-right top-[352.6px] w-[26px]">
    0.5
  </p>
  <p class="-translate-x-full [word-break:break-word] absolute font-normal leading-[normal] left-[514px] not-italic text-[#a1a1aa] text-[10px] text-right top-[292.2px] w-[26px]">
    1.0
  </p>
  <p class="-translate-x-full [word-break:break-word] absolute font-normal leading-[normal] left-[514px] not-italic text-[#a1a1aa] text-[10px] text-right top-[231.8px] w-[26px]">
    1.5
  </p>
  <p class="-translate-x-full [word-break:break-word] absolute font-normal leading-[normal] left-[514px] not-italic text-[#a1a1aa] text-[10px] text-right top-[171.4px] w-[26px]">
    2.0
  </p>
  <p class="-translate-x-full [word-break:break-word] absolute font-normal leading-[normal] left-[514px] not-italic text-[#a1a1aa] text-[10px] text-right top-[413px] w-[26px]">
    0
  </p>
  <div class="absolute bg-[#f4f4f5] h-[24px] left-[520px] rounded-[12px] top-[150px] w-[96px]"></div>
  <p class="-translate-x-1/2 [word-break:break-word] absolute font-semibold leading-[normal] left-[568px] not-italic text-[11px] text-center text-[#141416] top-[155px] w-[80px]">
    +34% CAGR
  </p>
  <div class="absolute bg-[#f4f4f5] left-[700px] size-[10px] top-[94px]"></div>
  <p class="[word-break:break-word] absolute font-normal leading-[normal] left-[714px] not-italic text-[#a1a1aa] text-[11px] top-[91px] whitespace-nowrap">
    Actual
  </p>
  <div class="absolute bg-[#0048ff] left-[770px] size-[10px] top-[94px]"></div>
  <p class="[word-break:break-word] absolute font-normal leading-[normal] left-[784px] not-italic text-[#a1a1aa] text-[11px] top-[91px] whitespace-nowrap">
    Plan
  </p>
  <p class="[word-break:break-word] absolute font-semibold leading-[normal] left-[520px] not-italic text-[#f4f4f5] text-[11px] top-[91px] whitespace-nowrap">
    ARR in EUR M
  </p>
  <div class="absolute bg-[#34343a] h-[84px] left-[64px] top-[256px] w-px"></div>
  <p class="[word-break:break-word] absolute font-bold leading-[normal] left-[76px] not-italic text-[#f4f4f5] text-[26px] top-[258px] whitespace-nowrap">
    118%
  </p>
  <div class="[word-break:break-word] absolute font-normal leading-[0] left-[76px] not-italic text-[#a1a1aa] text-[11px] top-[296px] whitespace-nowrap">
    <p class="leading-[1.3] mb-0">Net revenue</p>
    <p class="leading-[1.3]">retention</p>
  </div>
  <div class="absolute bg-[#34343a] h-[84px] left-[194px] top-[256px] w-px"></div>
  <p class="[word-break:break-word] absolute font-bold leading-[normal] left-[206px] not-italic text-[#f4f4f5] text-[26px] top-[258px] whitespace-nowrap">
    +67%
  </p>
  <div class="[word-break:break-word] absolute font-normal leading-[0] left-[206px] not-italic text-[#a1a1aa] text-[11px] top-[296px] whitespace-nowrap">
    <p class="leading-[1.3] mb-0">New customers</p>
    <p class="leading-[1.3]">since Q1</p>
  </div>
  <div class="absolute bg-[#34343a] h-[84px] left-[324px] top-[256px] w-px"></div>
  <p class="[word-break:break-word] absolute font-bold leading-[normal] left-[336px] not-italic text-[#f4f4f5] text-[26px] top-[258px] whitespace-nowrap">
    40%
  </p>
  <div class="[word-break:break-word] absolute font-normal leading-[0] left-[336px] not-italic text-[#a1a1aa] text-[11px] top-[296px] whitespace-nowrap">
    <p class="leading-[1.3] mb-0">Enterprise share</p>
    <p class="leading-[1.3]">in Q4 plan</p>
  </div>
  <div class="absolute bg-[#34343a] h-px left-[64px] top-[488px] w-[832px]"></div>
  <p class="[word-break:break-word] absolute font-normal leading-[normal] left-[64px] not-italic text-[#a1a1aa] text-[10px] top-[500px] whitespace-nowrap">
    Source: Finance controlling, ARR in EUR M, Q4 = plan as of 30 Sep 2026. Rounded figures.
  </p>
  <p class="-translate-x-full [word-break:break-word] absolute font-normal leading-[normal] left-[896px] not-italic text-[#a1a1aa] text-[10px] text-right top-[500px] w-[200px] whitespace-pre-wrap">Northwind & Co.  |  7</p>
</div>
