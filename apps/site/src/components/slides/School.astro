---
import './fonts.css';
import { asset } from '~/lib/links';

/** Figma Site Kit "Slide / School" (960 × 540), a content mock for product shots. */
---

<div class="bg-[#fff8e7] h-[540px] overflow-clip relative w-[960px]">
  <div class="absolute bg-[#2f9e44] h-[26px] left-[40px] rounded-[13px] top-[28px] w-[236px]"></div>
  <p class="[word-break:break-word] absolute font-[DM_Sans] font-bold leading-[normal] left-[54px] text-[11px] text-white top-[33px] tracking-[0.66px] whitespace-pre">BIOLOGY  |  CLASS 8B  |  LESSON 12</p>
  <p class="[word-break:break-word] absolute font-[DM_Sans] font-black leading-[normal] left-[40px] text-[#1e293b] text-[28px] top-[66px] whitespace-nowrap">
    How do plants make their own food?
  </p>
  <p class="[word-break:break-word] absolute font-[DM_Sans] font-normal leading-[1.3] left-[40px] text-[#475569] text-[13px] top-[110px] w-[520px]">
    Today you will name the inputs and outputs of photosynthesis, explain why leaves are green and plan a starch test.
  </p>
  <div class="absolute h-[270px] left-[40px] top-[150px] w-[520px]">
    <img alt="" class="absolute block inset-0 max-w-none size-full" src={asset('slides/school/photosynthesis-diagram.svg')} />
  </div>
  <div class="absolute flex h-[32.231px] items-center justify-center left-[147.49px] top-[186px] w-[82.07px]">
    <div class="flex-none rotate-6">
      <p class="[word-break:break-word] font-[Kalam] font-bold leading-[normal] not-italic relative text-[#e8590c] text-[15px] whitespace-nowrap">light energy</p>
    </div>
  </div>
  <div class="[word-break:break-word] absolute font-[Kalam] font-bold leading-[0] left-[40px] text-[#475569] text-[15px] top-[348px] whitespace-nowrap">
    <p class="leading-none mb-0">carbon dioxide (CO<sub class="text-[0.72em] leading-none">2</sub>)</p>
    <p class="leading-none">from the air</p>
  </div>
  <div class="[word-break:break-word] absolute font-[Kalam] font-bold leading-[0] left-[216px] text-[#2b7bd6] text-[15px] top-[372px] whitespace-nowrap">
    <p class="leading-none mb-0">water (H<sub class="text-[0.72em] leading-none">2</sub>O)</p>
    <p class="leading-none">from the roots</p>
  </div>
  <div class="[word-break:break-word] absolute font-[Kalam] font-bold leading-[0] left-[474px] text-[#2b7bd6] text-[15px] top-[150px] whitespace-nowrap">
    <p class="leading-none mb-0">oxygen (O<sub class="text-[0.72em] leading-none">2</sub>)</p>
    <p class="leading-none">is released</p>
  </div>
  <div class="[word-break:break-word] absolute font-[Kalam] font-bold leading-[0] left-[470px] not-italic text-[#e8590c] text-[15px] top-[312px] whitespace-nowrap">
    <p class="leading-none mb-0">glucose, stored</p>
    <p class="leading-none">as starch</p>
  </div>
  <div class="[word-break:break-word] absolute font-[Kalam] leading-[0] left-[330px] not-italic text-[#1b5e20] text-[13px] top-[356px] whitespace-nowrap">
    <p class="leading-none mb-0">chloroplasts make</p>
    <p class="leading-none">leaves green</p>
  </div>
  <div class="absolute bg-white border-[#e2d8bf] border-[1.5px] border-solid h-[74px] left-[40px] rounded-[14px] top-[428px] w-[520px]"></div>
  <p class="[word-break:break-word] absolute font-[DM_Sans] font-bold leading-[normal] left-[58px] text-[#1e293b] text-[17px] top-[440px] whitespace-nowrap">
    carbon dioxide + water
  </p>
  <p class="[word-break:break-word] absolute font-[Kalam] leading-[normal] left-[262px] not-italic text-[#e8590c] text-[12px] top-[433px] whitespace-nowrap">
    light, chlorophyll
  </p>
  <div class="absolute h-[12px] left-[256px] top-[447px] w-[96px]">
    <img alt="" class="absolute block inset-0 max-w-none size-full" src={asset('slides/school/reaction-arrow.svg')} />
  </div>
  <p class="[word-break:break-word] absolute font-[DM_Sans] font-bold leading-[normal] left-[364px] text-[#1e293b] text-[17px] top-[440px] whitespace-nowrap">
    glucose + oxygen
  </p>
  <p class="[word-break:break-word] absolute font-[DM_Sans] font-medium leading-[normal] left-[58px] text-[#475569] text-[14px] top-[470px] whitespace-pre">6 CO<sub class="text-[0.72em] leading-none">2</sub> + 6 H<sub class="text-[0.72em] leading-none">2</sub>O  →  C<sub class="text-[0.72em] leading-none">6</sub>H<sub class="text-[0.72em] leading-none">12</sub>O<sub class="text-[0.72em] leading-none">6</sub> + 6 O<sub class="text-[0.72em] leading-none">2</sub></p>
  <div class="absolute bg-white h-[300px] left-[592px] rounded-[18px] shadow-[0px_6px_18px_0px_rgba(120,92,26,0.12)] top-[66px] w-[328px]"></div>
  <div class="absolute bg-[#e7f5e9] h-[24px] left-[612px] rounded-[12px] top-[86px] w-[64px]"></div>
  <p class="[word-break:break-word] absolute font-[DM_Sans] font-bold leading-[normal] left-[622px] text-[#2f9e44] text-[12px] top-[90px] whitespace-nowrap">
    Task 1
  </p>
  <p class="[word-break:break-word] absolute font-[DM_Sans] font-medium leading-[normal] left-[688px] text-[#64748b] text-[12px] top-[90px] whitespace-pre">10 min  |  in pairs</p>
  <p class="[word-break:break-word] absolute font-[DM_Sans] font-bold leading-[normal] left-[612px] text-[#1e293b] text-[20px] top-[124px] whitespace-nowrap">
    Label the diagram
  </p>
  <div class="absolute border-2 border-[#2f9e44] border-solid left-[612px] rounded-[4px] size-[18px] top-[166px]"></div>
  <div class="absolute h-[10px] left-[615px] top-[170px] w-[12px]">
    <img alt="" class="absolute block inset-0 max-w-none size-full" src={asset('slides/school/check.svg')} />
  </div>
  <p class="[word-break:break-word] absolute font-[DM_Sans] font-normal leading-[1.3] left-[642px] text-[#94a3b8] text-[13px] top-[164px] w-[258px]">
    Copy the leaf into your workbook (p. 47) and add all five labels.
  </p>
  <div class="absolute border-2 border-[#94a3b8] border-solid left-[612px] rounded-[4px] size-[18px] top-[224px]"></div>
  <p class="[word-break:break-word] absolute font-[DM_Sans] font-normal leading-[1.3] left-[642px] text-[#1e293b] text-[13px] top-[222px] w-[258px]">
    Explain in two sentences why a plant in a dark cupboard stops growing.
  </p>
  <div class="absolute border-2 border-[#94a3b8] border-solid left-[612px] rounded-[4px] size-[18px] top-[282px]"></div>
  <p class="[word-break:break-word] absolute font-[DM_Sans] font-normal leading-[1.3] left-[642px] text-[#1e293b] text-[13px] top-[280px] w-[258px]">
    Bonus: why do leaves turn yellow and red in autumn?
  </p>
  <div class="absolute bg-[#ede7d6] h-[6px] left-[612px] rounded-[3px] top-[334px] w-[288px]"></div>
  <div class="absolute bg-[#2f9e44] h-[6px] left-[612px] rounded-[3px] top-[334px] w-[96px]"></div>
  <p class="[word-break:break-word] absolute font-[DM_Sans] font-medium leading-[normal] left-[612px] text-[#64748b] text-[10px] top-[344px] whitespace-nowrap">
    1 of 3 done
  </p>
  <div class="absolute flex h-[108.22px] items-center justify-center left-[640px] top-[379.65px] w-[240.701px]">
    <div class="-rotate-3 flex-none">
      <div class="bg-[#ffe066] h-[96px] relative shadow-[2px_6px_10px_0px_rgba(0,0,0,0.12)] w-[236px]"></div>
    </div>
  </div>
  <div class="absolute flex h-[45.79px] items-center justify-center left-[658px] top-[400.16px] w-[189.626px]">
    <div class="-rotate-3 flex-none">
      <div class="[word-break:break-word] font-[Kalam] font-bold leading-[0] not-italic relative text-[#5c4400] text-[17px] whitespace-nowrap">
        <p class="leading-[1.05] mb-0">Experiment on Thursday:</p>
        <p class="leading-[1.05]">bring a leaf from home!</p>
      </div>
    </div>
  </div>
  <div class="absolute bg-[#2f9e44] left-[40px] rounded-[4px] size-[8px] top-[516px]"></div>
  <div class="absolute bg-[#2f9e44] left-[54px] rounded-[4px] size-[8px] top-[516px]"></div>
  <div class="absolute bg-[#2f9e44] left-[68px] rounded-[4px] size-[8px] top-[516px]"></div>
  <div class="absolute bg-[#2f9e44] left-[82px] rounded-[4px] size-[8px] top-[516px]"></div>
  <div class="absolute bg-[#2f9e44] left-[96px] rounded-[4px] size-[8px] top-[516px]"></div>
  <div class="absolute bg-[#2f9e44] left-[110px] rounded-[4px] size-[8px] top-[516px]"></div>
  <div class="absolute bg-[#2f9e44] left-[124px] rounded-[4px] size-[8px] top-[516px]"></div>
  <div class="absolute bg-[#2f9e44] left-[138px] rounded-[4px] size-[8px] top-[516px]"></div>
  <div class="absolute bg-[#2f9e44] left-[152px] rounded-[4px] size-[8px] top-[516px]"></div>
  <div class="absolute bg-[#2f9e44] left-[166px] rounded-[4px] size-[8px] top-[516px]"></div>
  <div class="absolute bg-[#2f9e44] left-[180px] rounded-[4px] size-[8px] top-[516px]"></div>
  <div class="absolute bg-[#2f9e44] left-[194px] rounded-[4px] size-[8px] top-[516px]"></div>
  <div class="absolute bg-[#e2d8bf] left-[208px] rounded-[4px] size-[8px] top-[516px]"></div>
  <div class="absolute bg-[#e2d8bf] left-[222px] rounded-[4px] size-[8px] top-[516px]"></div>
  <div class="absolute bg-[#e2d8bf] left-[236px] rounded-[4px] size-[8px] top-[516px]"></div>
  <div class="absolute bg-[#e2d8bf] left-[250px] rounded-[4px] size-[8px] top-[516px]"></div>
  <div class="absolute bg-[#e2d8bf] left-[264px] rounded-[4px] size-[8px] top-[516px]"></div>
  <div class="absolute bg-[#e2d8bf] left-[278px] rounded-[4px] size-[8px] top-[516px]"></div>
  <p class="[word-break:break-word] absolute font-[DM_Sans] font-medium leading-[normal] left-[300px] text-[#64748b] text-[11px] top-[512px] whitespace-pre">Lesson 12 of 18  |  Unit 4: Plants and energy</p>
</div>
