---
import type { AppId } from '~/lib/apps';

/**
 * An app's mark (Figma: Brand Guide): what the app works on, paler, with the comment box on top
 * in the app's colour. Reader's is its page with the corner folded and a signature on it. Cloud's is a cloud with an arrow up, on its own canvas. The office's mark is two comment boxes in all
 * four colours. Drawn from the guide's measures so it stays sharp at any size and can move.
 *
 * Colours come from CSS: `--m` instead of the app's colour (white on a coloured tile), `--m-ground` what the paler layers
 * are mixed with (the page by default; `transparent` on a coloured tile), `--m-line` the strokes
 * on those layers, `--m-edge` an outline around the comment box.
 */
interface Props {
  app: AppId;
  /** Height in px; the width follows the mark's shape. */
  size?: number;
  class?: string;
}

const { app, size = 24, class: className } = Astro.props;
/** The comment box every app carries: three round corners, a sharp one bottom left. */
const BOX = 'M87.2 30.1H172.7A35 35 0 0 1 207.7 65.1V92.3A35 35 0 0 1 172.7 127.3H61.2A9 9 0 0 1 52.2 118.3V65.1A35 35 0 0 1 87.2 30.1Z';
/** Cloud's canvas and its comment box (Figma: Cloud Mark). */
const CLOUD_BOX =
  'M54.2 61.66C54.2 42.57 69.67 27.1 88.76 27.1H175.14C194.23 27.1 209.7 42.57 209.7 61.66V89.74C209.7 108.83 194.23 124.3 175.14 124.3H62.84C58.07 124.3 54.2 120.43 54.2 115.66Z';
const cloud = app === 'cloud';
const OFFICE =
  'M169.334 133.059C173.804 133.059 177.428 136.683 177.428 141.153V191.742C177.428 209.624 162.932 224.12 145.051 224.12H64.1074C46.226 224.12 31.7304 209.624 31.7304 191.742V165.436C31.7306 147.554 46.2262 133.059 64.1074 133.059H169.334ZM191.893 31.8799C209.774 31.8799 224.27 46.3755 224.27 64.2568V90.5635C224.27 108.445 209.774 122.94 191.893 122.94H86.6669C82.1966 122.94 78.5723 119.317 78.5722 114.847V64.2568C78.5723 46.3755 93.0688 31.8799 110.95 31.8799H191.893Z';
const officeMask = `url("data:image/svg+xml,${encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' viewBox='28 28 200 200'><path d='${OFFICE}'/></svg>`)}")`;
---

{
  app === 'office' ? (
    <span class:list={['mark mark-office', className]} style={`width:${size}px;height:${size}px;--mask:${officeMask}`} aria-hidden="true" />
  ) : (
    <svg
      class:list={['mark', `mark-${app}`, className]}
      style={`--app: var(--app-${app})`}
      width={cloud ? (size * 212) / 188 : (size * 208) / 192}
      height={size}
      viewBox={cloud ? '0 0 212 188' : '0 0 208 192'}
      fill="none"
      aria-hidden="true"
    >
      {app === 'slider' && (
        <>
          {/* a projection screen on a tripod, under its roll, a title and a bar chart on it */}
          <path class="m-legs" d="M96 114L60 190M96 114L132 190M96 114L96 182" />
          <rect class="m-50" x="20" y="20" width="152" height="154" rx="10" />
          <path class="m-ink" d="M30 42h12" />
          <g class="m-60">
            <rect x="30" y="118" width="16" height="46" rx="4" />
            <rect x="52" y="146" width="16" height="18" rx="4" />
            <rect x="74" y="100" width="16" height="64" rx="4" />
            <rect x="96" y="136" width="16" height="28" rx="4" />
            <rect x="118" y="152" width="16" height="12" rx="4" />
            <rect x="140" y="88" width="16" height="76" rx="4" />
          </g>
          <rect class="m-90" x="12" y="10" width="168" height="14" rx="7" />
        </>
      )}
      {app === 'writer' && (
        <>
          <rect class="m-50" x="4" y="2" width="146" height="189" rx="23.3" />
          <path class="m-ink" d="M21 160c7-13 14-21 19-18 6 4-9 22-2 23 8 1 12-17 21-15 7 2-1 13 6 14 8 1 12-9 22-9 8 0 13 3 28 2" />
        </>
      )}
      {app === 'reader' && (
        <>
          <path class="m-50" d="M27.3 2H108L150 44V167.7A23.3 23.3 0 0 1 126.7 191H27.3A23.3 23.3 0 0 1 4 167.7V25.3A23.3 23.3 0 0 1 27.3 2Z" />
          <path class="m-30" d="M108 2V32A12 12 0 0 0 120 44H150Z" />
          <path class="m-ink" d="M22 171.6C33.2 154 44.4 138 49.2 146C54 154 39.6 178 49.2 176.4C58.8 174.8 68.4 155.6 74.4 160.4C80.4 165.2 79.6 174.8 89.2 171.6C95.2 169.2 103.2 165.2 113.2 165.2" />
        </>
      )}
      {app === 'solver' && (
        <>
          <rect class="m-30" x="9" y="1" width="133" height="74" rx="21.6" />
          <rect class="m-50" x="1" y="87" width="61" height="93" rx="16" />
          <rect class="m-40" x="74" y="106" width="113" height="84" rx="21.6" />
          <path class="m-ink" d="M93 170l15-11 12 8 17-17 12 8 22-9" />
        </>
      )}
      {app === 'cloud' && (
        <>
          <circle class="m-40" cx="104" cy="65" r="64" />
          <circle class="m-50" cx="50" cy="97" r="46" />
          <rect class="m-60" x="2" y="101" width="186" height="86" rx="43" />
          <path class="m-arrow" d="M41 163V133M54 146L41 133L28 146" />
        </>
      )}
      <path class="m-box" d={cloud ? CLOUD_BOX : BOX} />
    </svg>
  )
}

<style>
  .mark {
    display: block;
    flex: none;
    /* Slider's tripod stands a little below the box */
    overflow: visible;
  }
  .mark-office {
    display: inline-block;
    background: conic-gradient(from 90deg, var(--app-solver) 0deg, var(--app-writer) 100deg, var(--app-cloud) 185deg, var(--app-slider) 270deg, var(--app-solver) 360deg);
    -webkit-mask: var(--mask) center / contain no-repeat;
    mask: var(--mask) center / contain no-repeat;
  }
  .m-30 {
    fill: color-mix(in srgb, var(--m, var(--app)) 30%, var(--m-ground, var(--color-canvas)));
  }
  .m-40 {
    fill: color-mix(in srgb, var(--m, var(--app)) 40%, var(--m-ground, var(--color-canvas)));
  }
  .m-50 {
    fill: color-mix(in srgb, var(--m, var(--app)) 50%, var(--m-ground, var(--color-canvas)));
  }
  .m-line,
  .m-ink {
    stroke-width: 6.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .m-line {
    stroke: var(--m-line, var(--color-canvas));
  }
  .m-ink {
    stroke: var(--m-ink, var(--m, var(--app)));
  }
  .m-legs {
    stroke: color-mix(in srgb, var(--m, var(--app)) 30%, var(--m-ground, var(--color-canvas)));
    stroke-width: 7;
    stroke-linecap: round;
  }
  .m-90 {
    fill: color-mix(in srgb, var(--m, var(--app)) 90%, var(--m-ground, var(--color-canvas)));
  }
  .m-60 {
    fill: color-mix(in srgb, var(--m, var(--app)) 60%, var(--m-ground, var(--color-canvas)));
  }
  .m-arrow {
    stroke: var(--m-ink, var(--m, var(--app)));
    stroke-width: 6;
  }
  .m-box {
    fill: var(--m, var(--app));
    stroke: var(--m-edge, none);
    stroke-width: 7;
    paint-order: stroke;
  }
</style>
