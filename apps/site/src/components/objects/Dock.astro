---
import Mark from '../Mark.astro';
import { appPage, s, type Lang } from '~/i18n';
import { APP_NAMES, PRODUCTS, isLive, type ProductId } from '~/lib/apps';

/**
 * The six apps as one hand of tiles (Figma: App Icons): each in its colour running into the
 * next one's, the mark on it in white, on its paler copy down left. They are dealt from the top
 * right, lean towards the pointer and step forward when hovered. Each leads to its app's page.
 */
interface Props {
  lang: Lang;
  /** The app whose page this is: its tile stands out, the others are the rest of the family. */
  current?: ProductId;
  class?: string;
}

const { lang, current, class: className } = Astro.props;
const words = s(lang);
/** The colour each tile runs into, and how it sits in the hand. */
const LOOK: Record<ProductId, { to: string; turn: number; drop: number }> = {
  slider: { to: 'var(--app-writer)', turn: -9, drop: 7 },
  writer: { to: 'var(--app-solver)', turn: -5.4, drop: 3 },
  solver: { to: 'var(--app-writer)', turn: -1.8, drop: 0 },
  reader: { to: 'var(--app-cloud)', turn: 1.8, drop: 0 },
  sender: { to: 'var(--app-writer)', turn: 5.4, drop: 3 },
  cloud: { to: 'var(--app-writer)', turn: 9, drop: 7 },
};
---

<div class:list={['dock', current && 'has-current', className]} data-tilt>
  {
    PRODUCTS.map((id, i) => (
      <a
        href={appPage(id, lang)}
        class="dock-item"
        aria-current={id === current ? 'page' : undefined}
        style={`--c: var(--app-${id}); --to: ${LOOK[id].to}; --turn: ${LOOK[id].turn}deg; --drop: ${LOOK[id].drop}%; --i: ${i}`}
      >
        <span class="dock-tile">
          <Mark app={id} size={100} class="dock-mark" />
        </span>
        <span class="dock-label">
          <strong>{APP_NAMES[id]}</strong>
          <span>{isLive(id) ? words.kinds[id] : words.status.soon}</span>
        </span>
      </a>
    ))
  }
</div>

<style>
  .dock {
    --tile: clamp(76px, 19vw, 236px);
    display: flex;
    justify-content: center;
    perspective: 1600px;
  }
  .dock-item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(var(--tile) * 0.16);
    margin: 0 calc(var(--tile) * -0.035);
    translate: 0 var(--drop);
    rotate: var(--turn);
    transition:
      translate 500ms var(--ease-overshoot),
      rotate 500ms var(--ease-overshoot),
      scale 500ms var(--ease-overshoot);
  }
  .dock-item:hover,
  .dock-item:focus-visible {
    z-index: 2;
    translate: 0 -7%;
    rotate: 0deg;
    scale: 1.08;
  }
  .dock-tile {
    position: relative;
    display: grid;
    place-items: center;
    width: var(--tile);
    height: var(--tile);
    border-radius: 22.5%;
    background:
      radial-gradient(90% 90% at var(--lx, 24%) var(--ly, 12%), rgb(255 255 255 / 0.34), transparent 60%),
      linear-gradient(140deg, var(--c) 38%, color-mix(in srgb, var(--c) 45%, var(--to)) 100%);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.22),
      calc(var(--tile) * -0.07) calc(var(--tile) * 0.07) 0 color-mix(in srgb, var(--c) 45%, transparent),
      0 calc(var(--tile) * 0.2) calc(var(--tile) * 0.3) calc(var(--tile) * -0.14) color-mix(in srgb, var(--c) 70%, transparent);
    transform: rotateX(calc(var(--ty, 0) * 1.4deg)) rotateY(calc(var(--tx, 0) * 1.4deg));
    transition:
      transform 500ms var(--ease-emphasized),
      box-shadow 500ms var(--ease-emphasized);
  }
  .dock-item:hover .dock-tile {
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.3),
      calc(var(--tile) * -0.11) calc(var(--tile) * 0.11) 0 color-mix(in srgb, var(--c) 45%, transparent),
      0 calc(var(--tile) * 0.3) calc(var(--tile) * 0.36) calc(var(--tile) * -0.14) color-mix(in srgb, var(--c) 80%, transparent);
  }
  /* The mark in white on its colour: paler layers see-through, the comment box solid. */
  .dock-tile :global(.dock-mark) {
    --m: #fff;
    --m-ground: transparent;
    --m-line: #fff;
    --m-ink: #fff;
    --m-face: var(--c);
    width: 58%;
    height: auto;
    filter: drop-shadow(0 calc(var(--tile) * 0.02) calc(var(--tile) * 0.04) rgb(0 0 0 / 0.22));
  }
  .dock-label {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    font-size: clamp(12px, 1.2vw, 15px);
    line-height: 1.3;
    color: var(--color-fg-subtle);
    rotate: calc(var(--turn) * -1);
    transition: rotate 500ms var(--ease-overshoot);
  }
  .dock-item:hover .dock-label {
    rotate: 0deg;
  }
  .dock-label strong {
    font-size: clamp(14px, 1.5vw, 19px);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-fg);
  }
  /* On an app's own page the others step back a little. */
  .dock.has-current .dock-item:not([aria-current]) .dock-tile {
    filter: saturate(0.75);
    opacity: 0.82;
  }
  .dock.has-current .dock-item:hover .dock-tile {
    filter: none;
    opacity: 1;
  }

  /* Dealt from the top right, one after the other. */
  :global(.js) .dock-item {
    opacity: 0;
  }
  :global(.js .is-in) .dock-item {
    opacity: 1;
    animation: dock-deal 900ms var(--ease-emphasized) backwards;
    animation-delay: calc(250ms + var(--i) * 110ms);
  }
  @keyframes dock-deal {
    from {
      opacity: 0;
      translate: 60% -90%;
      rotate: 28deg;
    }
  }
  @media (max-width: 520px) {
    .dock-label span {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js .is-in) .dock-item {
      animation: none;
    }
    .dock-item,
    .dock-tile {
      transition: none;
    }
  }
</style>
