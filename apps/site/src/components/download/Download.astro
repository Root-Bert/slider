---
import { LogoMark } from '@/ui/Logo';
import Button from '~/components/Button.astro';
import { t, type Lang } from '~/i18n';
import { APP_URL, REPO_URL } from '~/lib/links';

/**
 * The desktop app's download page: a slide on Slider orange (the logo's stack) with the app icon,
 * a part for the Mac (Apple Silicon) and one for Linux (a file for every Linux and a package for
 * Ubuntu and Debian). The system the browser runs on comes first with the solid button; a Linux
 * on ARM gets the arm64 files. The files are the latest public release's (ci.yml, job desktop),
 * under names that never change.
 */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang).download;
const file = (name: string) => `${REPO_URL}/releases/latest/download/${name}`;
const systems = [
  {
    os: 'mac',
    title: d.macTitle,
    note: d.macNote,
    files: [{ label: d.macButton, href: file('Slider-arm64.dmg') }],
  },
  {
    os: 'linux',
    title: d.linuxTitle,
    note: d.linuxNote,
    files: [
      { label: d.linuxButton, href: file('Slider-x86_64.AppImage'), arm: file('Slider-arm64.AppImage') },
      { label: d.debButton, href: file('Slider-amd64.deb'), arm: file('Slider-arm64.deb') },
    ],
  },
] as const;
---

<section class="dl" data-section>
  <h1 class="dl-title" data-reveal>{d.title}</h1>
  <p class="dl-sub" data-reveal style="--i: 1">{d.sub}</p>

  <div class="dl-card" data-reveal style="--i: 1.5">
    <div class="dl-text">
      <h2>{d.cardTitle}</h2>
      <p>{d.cardBody}</p>
      {
        [systems, [systems[1], systems[0]]].map((order, i) => (
          <div class="dl-systems" data-lead={order[0].os} hidden={i === 1}>
            {order.map((system, s) => (
              <div class="dl-system">
                <h3>{system.title}</h3>
                <div class="dl-buttons">
                  {system.files.map((f, b) => (
                    <span class="dl-file" data-arm={'arm' in f ? f.arm : undefined}>
                      <Button href={f.href} variant={s === 0 && b === 0 ? 'primary' : 'secondary'}>
                        {f.label}
                      </Button>
                    </span>
                  ))}
                </div>
                <p class="dl-note">{system.note}</p>
                {system.os === 'linux' && (
                  <p class="dl-note">
                    {d.armNote}{' '}
                    <a href={`${REPO_URL}/releases/latest`}>{d.armLink}</a>
                  </p>
                )}
              </div>
            ))}
          </div>
        ))
      }
    </div>
    <div class="dl-icon" aria-hidden="true">
      <span><LogoMark width={150} tone="onOrange" /></span>
    </div>
  </div>

  <p class="dl-browser" data-reveal style="--i: 2">
    {d.browser}{' '}
    <a href={`${APP_URL}/`}>{d.browserButton}</a>
  </p>
</section>

<script>
  type Hints = { getHighEntropyValues(keys: string[]): Promise<{ architecture?: string }> };

  /** The browser's system: Linux (not Android) or anything else, which gets the Mac first. */
  const linux = /linux/i.test(navigator.userAgent) && !/android/i.test(navigator.userAgent);

  async function isArm(): Promise<boolean> {
    const hints = (navigator as Navigator & { userAgentData?: Hints }).userAgentData;
    if (hints?.getHighEntropyValues) {
      const { architecture } = await hints.getHighEntropyValues(['architecture']);
      return architecture === 'arm';
    }
    return /aarch64|arm/i.test(navigator.platform);
  }

  if (linux) {
    for (const group of document.querySelectorAll<HTMLElement>('.dl-systems')) {
      group.hidden = group.dataset.lead !== 'linux';
    }
    void isArm().then((arm) => {
      if (!arm) return;
      for (const file of document.querySelectorAll<HTMLElement>('.dl-file[data-arm]')) {
        const link = file.querySelector('a');
        if (link) link.href = file.dataset.arm ?? link.href;
      }
    });
  }
</script>

<style>
  .dl {
    --step: clamp(12px, 1.8vw, 26px);
    max-width: 1440px;
    margin: 0 auto;
    padding: 120px 32px 0;
  }
  .dl-title {
    max-width: 11em;
    font-size: clamp(44px, 5.6vw, 92px);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }
  .dl-sub {
    max-width: 30em;
    margin-top: 28px;
    font-size: 19px;
    line-height: 1.5;
    color: var(--color-fg-muted);
  }

  /* A slide on a Slider-orange slide, down and to the left: the logo's stack. */
  .dl-card {
    display: grid;
    grid-template-columns: 60fr 40fr;
    margin: 80px 0 var(--step) var(--step);
    overflow: hidden;
    border-radius: clamp(20px, 2.6vw, 40px);
    background: var(--color-surface-1);
    box-shadow:
      inset 0 0 0 1px var(--color-hairline),
      calc(var(--step) * -1) var(--step) 0 var(--color-logo);
  }
  .dl-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    padding: clamp(32px, 5vw, 72px);
  }
  .dl-text h2 {
    font-size: clamp(32px, 3.6vw, 56px);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.05em;
  }
  .dl-text > p:first-of-type {
    max-width: 28em;
    font-size: 18px;
    line-height: 1.5;
    color: var(--color-fg-muted);
  }
  .dl-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 16px;
    margin: 4px 0;
  }
  .dl-systems {
    display: flex;
    flex-direction: column;
    gap: 28px;
    align-self: stretch;
    margin-top: 12px;
  }
  .dl-systems[hidden] {
    display: none;
  }
  .dl-system {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
  .dl-system + .dl-system {
    padding-top: 28px;
    border-top: 1px solid var(--color-hairline);
  }
  .dl-system h3 {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .dl-file {
    display: contents;
  }
  .dl-note a {
    color: var(--color-fg-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .dl-note {
    max-width: 34em;
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-fg-subtle);
  }

  /* The app icon: the mark on Slider orange, in a rounded square. */
  .dl-icon {
    display: grid;
    place-items: center;
    padding: 48px;
    background: color-mix(in srgb, var(--color-logo) 10%, transparent);
  }
  .dl-icon span {
    display: grid;
    place-items: center;
    width: min(260px, 100%);
    aspect-ratio: 1;
    border-radius: 22%;
    background: var(--color-logo);
    box-shadow:
      0 24px 48px -16px rgb(0 0 0 / 0.35),
      inset 0 1px 0 rgb(255 255 255 / 0.25);
  }

  .dl-browser {
    margin-top: calc(var(--step) + 28px);
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-fg-muted);
  }
  .dl-browser a {
    color: var(--color-fg);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 860px) {
    .dl {
      padding: 96px 16px 0;
    }
    .dl-card {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 56px;
    }
    .dl-icon {
      order: -1;
      padding: 32px;
    }
    .dl-icon span {
      width: 160px;
    }
    .dl-icon :global(svg) {
      width: 92px;
      height: auto;
    }
  }
</style>
