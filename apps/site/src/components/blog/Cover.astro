---
import Slide from '~/components/slides/Slide.astro';
import { asset } from '~/lib/links';
import { ACCENT_CSS, type Post } from './posts';

/**
 * A post's cover, drawn in code: night-dark in both themes with a glow in the post's accent, and
 * on it a versus pill pair, a ranking, a version number, a slide with pins, or code braces.
 */
interface Props {
  post: Post;
  /** `card` in the grid, `wide` for the featured post and the article hero. */
  size?: 'card' | 'wide';
  class?: string;
}

const { post, size = 'card', class: className } = Astro.props;
const { cover, accent } = post.data;
const wide = size === 'wide';
---

<div
  class:list={['cv', wide && 'is-wide', className]}
  style={`--bg: ${ACCENT_CSS[accent]}`}
  aria-hidden="true"
>
  {
    cover.kind === 'versus' && (
      <div class="cv-versus">
        <span class="cv-pill is-slider">{cover.self ?? 'Slider'}</span>
        <span class="cv-vs">vs</span>
        <span class="cv-pill is-other">{cover.other}</span>
      </div>
    )
  }
  {
    cover.kind === 'ranking' && (
      <div class="cv-ranking">
        <div class="is-first">
          <span>1  Slider</span>
          <i style="width: 140px" />
        </div>
        {[110, 80].map((w, i) => (
          <div>
            <span>{i + 2}</span>
            <i style={`width: ${w}px`} />
          </div>
        ))}
      </div>
    )
  }
  {cover.kind === 'version' && <span class="cv-big">{cover.label}</span>}
  {
    cover.kind === 'slide' && (
      <div class="relative">
        <Slide name="FloorPlan" width={250} />
        <img src={asset('blog/pin-1.svg')} alt="" class="absolute top-[24px] left-[57px] size-9 max-w-none" />
        <img src={asset('blog/pin-2.svg')} alt="" class="absolute top-[66px] left-[137px] size-9 max-w-none" />
        <img src={asset('blog/pin-3.svg')} alt="" class="absolute top-[35px] left-[197px] size-9 max-w-none" />
      </div>
    )
  }
  {cover.kind === 'code' && <span class="cv-big cv-code">{'{ }'}</span>}
</div>

<style>
  .cv {
    --ground: #0b0b0d;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 10;
    container-type: inline-size;
    overflow: hidden;
    border-radius: var(--cv-radius, 20px);
    background:
      radial-gradient(70% 78% at 50% 50%, color-mix(in srgb, var(--bg) 42%, transparent), transparent 100%),
      var(--ground);
    color: #fff;
  }
  /* The app's dot grid, faint, so the cover reads as a canvas. */
  .cv::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgb(255 255 255 / 0.13) 1px, transparent 1.2px);
    background-size: 22px 22px;
    pointer-events: none;
  }
  .cv > * {
    position: relative;
    transition: scale 500ms var(--ease-emphasized);
  }
  :global(a:hover) .cv > * {
    scale: 1.04;
  }
  .cv.is-wide {
    --cv-radius: clamp(20px, 2.2vw, 32px);
  }

  .cv-versus {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  /* Sized by the cover's width, so the pair always fits, from a phone to the article hero. */
  .cv-pill {
    padding: 0.55em 1.1em;
    border-radius: 999px;
    font-size: clamp(12px, 3.6cqw, 26px);
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .cv-pill.is-slider {
    background: #fff;
    color: #000;
  }
  .cv-pill.is-other {
    background: #151517;
    color: #fff;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.16);
  }
  .cv-vs {
    font-family: var(--font-mono);
    font-size: 13px;
    color: rgb(255 255 255 / 0.55);
  }

  .cv-ranking {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .cv-ranking div {
    display: flex;
    width: max-content;
    align-items: center;
    gap: 10px;
    padding: 10px 16px 10px 12px;
    border-radius: 12px;
    background: rgb(255 255 255 / 0.08);
    color: rgb(255 255 255 / 0.55);
    font-family: var(--font-mono);
    font-size: 13px;
    white-space: pre;
  }
  .cv-ranking div.is-first {
    background: #0b0b0d;
    color: #fff;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.16);
  }
  .cv-ranking i {
    height: 8px;
    border-radius: 99px;
    background: rgb(255 255 255 / 0.25);
  }
  .cv-ranking .is-first i {
    background: var(--bg);
  }

  .cv-big {
    font-size: 96px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    text-shadow: 0 0 60px color-mix(in srgb, var(--bg) 80%, transparent);
  }
  .is-wide .cv-big {
    font-size: clamp(96px, 12vw, 180px);
  }
  .cv-code {
    font-family: var(--font-mono);
    font-weight: 500;
    letter-spacing: 0;
    color: var(--bg);
  }
  @media (prefers-reduced-motion: reduce) {
    .cv > * {
      transition: none;
    }
  }
</style>
