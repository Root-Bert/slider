---
import Slide from '~/components/slides/Slide.astro';
import { asset } from '~/lib/links';
import type { Post } from './posts';

/**
 * A post's cover, drawn in code: an accent glow behind a versus pill pair, a ranking, a version
 * number, a slide with pins, or code braces.
 */
interface Props {
  post: Post;
  /** `card` in the grid, `wide` for the featured post and the article hero. */
  size?: 'card' | 'wide';
  class?: string;
}

const { post, size = 'card', class: className } = Astro.props;
const { cover, accent } = post.data;
const wide = size === 'wide';
const glow = {
  powerpoint: 'glow-powerpoint.svg',
  cyan: 'glow-cyan.svg',
  green: 'glow-green.svg',
  violet: 'glow-violet.svg',
  yellow: 'glow-yellow.svg',
  blue: 'glow-blue.svg',
}[accent];
const pill = wide
  ? 'px-3.5 py-2 text-[15px] sm:px-[18px] sm:py-2.5 sm:text-[22px]'
  : 'px-[18px] py-2.5 text-[17px]';
---

<div
  class:list={[
    'relative isolate flex items-center justify-center overflow-hidden bg-surface-1',
    wide ? 'h-[400px]' : 'h-[220px]',
    className,
  ]}
  aria-hidden="true"
>
  <img
    src={asset(`blog/${glow}`)}
    alt=""
    class="pointer-events-none absolute -z-10 h-[140%] w-[120%] max-w-none"
  />
  {
    cover.kind === 'versus' && (
      <div class="flex items-center gap-2.5 sm:gap-3.5">
        <span class:list={['rounded-full bg-primary font-semibold text-on-primary shadow-glow ring-hairline-strong', pill]}>
          Slider
        </span>
        <span class="text-sm text-fg-subtle">vs</span>
        <span class:list={['rounded-full bg-glass-elevated font-semibold whitespace-nowrap text-fg ring-hairline-strong', pill]}>
          {cover.other}
        </span>
      </div>
    )
  }
  {
    cover.kind === 'ranking' && (
      <div class="flex flex-col gap-2 self-start pt-11 pr-24">
        <div class="flex items-center gap-2.5 rounded-control-sm bg-glass-elevated py-2.5 pr-4 pl-3 ring-hairline-strong">
          <span class="text-[13px] tabular-nums whitespace-pre text-fg">1  Slider</span>
          <span class="h-2 w-[140px] rounded-thumb bg-accent-cyan shadow-[0_0_10px_rgb(0_224_255/0.7)]" />
        </div>
        {[110, 80].map((w, i) => (
          <div class="flex w-max items-center gap-2.5 rounded-control-sm bg-glass py-2.5 pr-4 pl-3 ring-hairline">
            <span class="text-[13px] tabular-nums text-fg-faint">{i + 2}</span>
            <span class="h-2 rounded-thumb bg-fg-faint" style={`width: ${w}px`} />
          </div>
        ))}
      </div>
    )
  }
  {
    cover.kind === 'version' && (
      <span class="text-[96px] font-black tracking-[-0.05em] text-fg [text-shadow:0_0_30px_rgb(255_255_255/0.25),0_0_90px_rgb(255_255_255/0.08)]">
        {cover.label}
      </span>
    )
  }
  {
    cover.kind === 'slide' && (
      <div class="relative">
        <Slide name="FloorPlan" width={250} />
        <img src={asset('blog/pin-1.svg')} alt="" class="absolute top-[24px] left-[57px] size-9 max-w-none" />
        <img src={asset('blog/pin-2.svg')} alt="" class="absolute top-[66px] left-[137px] size-9 max-w-none" />
        <img src={asset('blog/pin-3.svg')} alt="" class="absolute top-[35px] left-[197px] size-9 max-w-none" />
      </div>
    )
  }
  {
    cover.kind === 'code' && (
      <span class="font-mono text-[80px] font-medium text-accent-blue [text-shadow:0_0_30px_rgb(0_72_255/0.5)]">
        {'{ }'}
      </span>
    )
  }
</div>
