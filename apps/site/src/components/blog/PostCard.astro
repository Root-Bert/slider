---
import Cover from './Cover.astro';
import PostMeta from './PostMeta.astro';
import { postPage, tagKey, type Post } from './posts';
import type { Lang } from '~/i18n';

/** A post in the grid: a night-dark card, its cover glowing on top, then meta, title, teaser. */
interface Props {
  post: Post;
  lang?: Lang;
  index?: number;
}

const { post, lang = 'en', index = 0 } = Astro.props;
---

<a
  href={postPage(post, lang)}
  class="post-card"
  data-reveal
  data-post
  data-tag={tagKey(post.data.tag)}
  data-text={`${post.data.title} ${post.data.description}`.toLowerCase()}
  style={`--i: ${index}`}
>
  <Cover post={post} />
  <div class="post-card-text">
    <PostMeta post={post} lang={lang} />
    <h3>{post.data.title}</h3>
    <p>{post.data.description}</p>
  </div>
</a>

<style is:global>
  /* Global: the blog's open call is the same card without a post behind it. */
  .post-card {
    --cv-radius: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: clamp(20px, 2vw, 28px);
    background: #131315;
    color: #fff;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
  }
  .post-card-text {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 12px;
    padding: 24px 24px 30px;
  }
  .post-card-text h3 {
    font-size: 21px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .post-card-text p {
    font-size: 15px;
    line-height: 1.55;
    color: rgb(255 255 255 / 0.6);
  }
</style>
