---
import Cover from './Cover.astro';
import PostMeta from './PostMeta.astro';
import { tagKey, type Post } from './posts';
import { page } from '~/lib/links';

/** A post in the grid: its cover slide on top, then meta, title, teaser, no box around. */
interface Props {
  post: Post;
  index?: number;
}

const { post, index = 0 } = Astro.props;
---

<a
  href={page(`blog/${post.id}`)}
  class="group flex flex-col"
  data-reveal
  data-post
  data-tag={tagKey(post.data.tag)}
  data-text={`${post.data.title} ${post.data.description}`.toLowerCase()}
  style={`--i: ${index}`}
>
  <Cover post={post} />
  <div class="flex flex-col gap-3 pt-5">
    <PostMeta post={post} />
    <h3 class="text-xl leading-[1.3] font-semibold tracking-[-0.01em] text-fg">{post.data.title}</h3>
    <p class="text-sm leading-[1.55] text-fg-subtle">{post.data.description}</p>
  </div>
</a>
