---
import Cover from './Cover.astro';
import PostMeta from './PostMeta.astro';
import { tagKey, type Post } from './posts';
import { page } from '~/lib/links';

/** A post in the grid: cover on top, meta, title, teaser. */
interface Props {
  post: Post;
  index?: number;
}

const { post, index = 0 } = Astro.props;
---

<a
  href={page(`blog/${post.id}`)}
  class="group flex flex-col overflow-hidden rounded-[20px] bg-glass ring-hairline transition-colors hover:bg-glass-hover"
  data-reveal
  data-post
  data-tag={tagKey(post.data.tag)}
  data-text={`${post.data.title} ${post.data.description}`.toLowerCase()}
  style={`--i: ${index}`}
>
  <Cover post={post} />
  <div class="flex flex-col gap-3 px-6 pt-6 pb-7">
    <PostMeta post={post} />
    <h3 class="text-xl leading-[1.3] font-semibold tracking-[-0.01em] text-fg">{post.data.title}</h3>
    <p class="text-sm leading-[1.55] text-fg-subtle">{post.data.description}</p>
  </div>
</a>
