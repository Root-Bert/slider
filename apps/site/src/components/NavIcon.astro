---
/**
 * The website's page icons (Site / Header), drawn from Slider's own marks instead of a generic
 * set: the logo's two offset slides, the reviewer cursor, the orbit with its satellite, the
 * selection box with corner handles and a comment card. 20 × 20, outlined; one filled detail per
 * icon takes the sage accent on the current page.
 */
export type NavIconName = 'home' | 'product' | 'vision' | 'pricing' | 'blog';

interface Props {
  name: NavIconName;
  size?: number;
  active?: boolean;
}

const { name, size = 18, active = false } = Astro.props;
const accent = active ? 'var(--color-sage)' : 'currentColor';
---

<svg
  width={size}
  height={size}
  viewBox="0 0 20 20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class="shrink-0"
>
  {
    name === 'home' && (
      <>
        <rect x="2" y="7.5" width="12" height="9" rx="2.2" opacity="0.5" />
        <rect x="6" y="3.5" width="12" height="9" rx="2.2" fill={accent} stroke={accent} />
      </>
    )
  }
  {
    name === 'product' && (
      <>
        <rect x="2" y="3.5" width="14" height="10" rx="2.2" />
        <path d="M10.8 9 18.4 12l-3.3 1.1-1.1 3.3z" fill={accent} stroke={accent} stroke-width="1.2" />
      </>
    )
  }
  {
    name === 'vision' && (
      <>
        <mask id="nav-icon-orbit">
          <rect width="20" height="20" fill="white" />
          <circle cx="10" cy="10.5" r="5.3" fill="black" />
        </mask>
        <circle cx="10" cy="10.5" r="4" />
        <ellipse cx="10" cy="10.5" rx="8.6" ry="2.9" transform="rotate(-24 10 10.5)" opacity="0.6" mask="url(#nav-icon-orbit)" />
        <circle cx="17.6" cy="7" r="1.7" fill={accent} stroke="none" />
      </>
    )
  }
  {
    name === 'pricing' && (
      <>
        <rect x="3.5" y="3.5" width="13" height="13" rx="0.8" stroke-width="1.3" />
        {[1.9, 14.9].flatMap((x) =>
          [1.9, 14.9].map((y) => <rect x={x} y={y} width="3.2" height="3.2" rx="0.6" fill={accent} stroke="none" />),
        )}
        <path d="M12.6 7.6a3 3 0 1 0 0 4.8M7.4 9.2h3.6M7.4 10.9h3.6" stroke-width="1.4" />
      </>
    )
  }
  {
    name === 'blog' && (
      <>
        <path d="M5.4 3.5h9.2a2.4 2.4 0 0 1 2.4 2.4v5.2a2.4 2.4 0 0 1-2.4 2.4H9.2L5.6 16.6v-3.1h-.2A2.4 2.4 0 0 1 3 11.1V5.9a2.4 2.4 0 0 1 2.4-2.4z" />
        <path d="M6.8 7.4h6.4" stroke={accent} />
        <path d="M6.8 10h3.8" opacity="0.6" />
      </>
    )
  }
</svg>
