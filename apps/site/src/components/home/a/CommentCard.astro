---
import { accentAlpha, accentColor } from '@/lib/accent';
import { Avatar } from '@/ui/Avatar';
import { Icon } from '@/ui/Icon';
import { person, type PersonName } from '~/lib/people';

/**
 * Canvas comment card as in the app (UI kit "Canvas Comment"): glass card, avatar + name +
 * meta, the resolve check, and the body. `selected` gives it the author's accent edge and glow.
 */
interface Props {
  name: PersonName;
  meta: string;
  width?: number;
  selected?: boolean;
  class?: string;
  style?: string;
}

const { name, meta, width = 260, selected = false, class: className, style } = Astro.props;
const author = person(name);
const ring = selected
  ? `box-shadow: inset 0 0 0 1px ${accentColor(author.color)}, 0 0 20px ${accentAlpha(author.color, 50)};`
  : '';
---

<div
  class:list={['flex flex-col gap-2 rounded-panel bg-glass px-3.5 py-3 backdrop-blur-md', className]}
  style={`width: ${width}px; ${ring} ${style ?? ''}`}
>
  <div class="flex items-center gap-2">
    <Avatar author={author} size={24} nativeTitle={false} />
    <span class="text-xs font-medium text-fg">{name}</span>
    <span class="text-caption text-fg-subtle">{meta}</span>
    <span class="flex-1"></span>
    <span class="flex size-7 items-center justify-center rounded-chip text-fg-subtle">
      <Icon name="check" size={18} />
    </span>
  </div>
  <slot />
</div>
