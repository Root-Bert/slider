---
import { accentColor } from '@/lib/accent';
import { person, type PersonName } from '~/lib/people';

/** A comment pin on a slide, as in the app: 14px dot in the author's accent, white ring. */
interface Props {
  by: PersonName;
  [attr: `data-${string}`]: string | undefined;
  class?: string;
  style?: string;
}

const { by, class: className, style, ...rest } = Astro.props;
---

<span
  class:list={['absolute size-3.5 rounded-full shadow-[0_0_0_2px_white,var(--shadow-pin)]', className]}
  style={`background: ${accentColor(person(by).color)}; ${style ?? ''}`}
  aria-hidden="true"
  {...rest}></span>
