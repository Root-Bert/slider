---
import { Avatar } from '@/ui/Avatar';
import { Icon } from '@/ui/Icon';
import { accentColor } from '@/lib/accent';
import { person, type PersonName } from '~/lib/people';

/**
 * A comment card as the app draws it on the canvas (UI kit "Canvas Comment"): glass card, avatar,
 * name, slide | time, the resolve check. `selected` gives it the author's accent edge and glow.
 */
interface Props {
  name: PersonName;
  meta: string;
  selected?: boolean;
  class?: string;
  style?: string;
}

const { name, meta, selected = false, class: className, style } = Astro.props;
const accent = accentColor(person(name).color);
---

<div
  class:list={['flex w-full flex-col gap-2 overflow-hidden rounded-panel bg-glass px-3.5 py-3', className]}
  style={`${selected ? `box-shadow: inset 0 0 0 1px ${accent}, 0 0 20px color-mix(in srgb, ${accent} 50%, transparent);` : ''} --accent: ${accent}; ${style ?? ''}`}
>
  <div class="flex items-center gap-2">
    <Avatar author={person(name)} size={24} nativeTitle={false} />
    <span class="text-xs font-medium text-fg">{name}</span>
    <span class="text-caption text-fg-subtle">{meta}</span>
    <span class="flex-1"></span>
    <span class="flex size-7 items-center justify-center rounded-chip text-fg-subtle">
      <Icon name="check" size={18} />
    </span>
  </div>
  <slot />
</div>
