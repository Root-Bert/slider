---
import { Avatar, AvatarStack } from '@/ui/Avatar';
import { buttonClasses } from '@/ui/button-classes';
import Cursor from '~/components/Cursor.astro';
import Highlight from '~/components/Highlight.astro';
import SectionMark from '~/components/SectionMark.astro';
import Tag from '~/components/Tag.astro';
import { accentColor } from '@/lib/accent';
import { asset } from '~/lib/links';
import { person } from '~/lib/people';
import Motion from './b/Motion.astro';
import Stars from './b/Stars.astro';

/**
 * Homepage | Live: reviewing together – the crew orbiting the deck, who is here, follow mode and
 * a workspace invite.
 */
const img = (name: string) => asset(`home-b/live/${name}`);
const others = [person('Finnja'), person('Carolin'), person('Lara')];
const stars = [
  [621.5, 313.6, 1.5], [620.9, 307.3, 2.2], [664.4, 410.6, 3], [581.7, 310.2, 1.5], [40, 415.4, 1.5],
  [958.9, 108.9, 1.5], [1094, 151.2, 1.5], [19.5, 407.3, 2.2], [1372.6, 35.2, 1.5], [1415, 235.2, 1.5],
  [1201.9, 349.3, 2.2], [164.1, 304.5, 1.5], [1108.2, 333.8, 1.5], [1339, 493.3, 1.5], [230, 439.4, 1.5],
  [1002.8, 207.7, 1.5], [644.1, 272.3, 1.5], [1205.1, 165, 3], [730.6, 5.7, 1.5], [625.2, 103.9, 1.5],
  [626.3, 63.2, 2.2], [1313.3, 355.3, 2.2], [981.4, 415.6, 1.5], [670.1, 0, 1.5], [519.5, 323.2, 1.5],
  [1030.3, 370.6, 1.5], [786.6, 199.3, 1.5], [792.2, 434, 2.2], [515.5, 481, 1.5], [342.7, 474.5, 2.2],
  [816.5, 319.6, 2.2], [691.6, 217.6, 2.2], [995.6, 302.1, 1.5], [1093.6, 276.7, 1.5], [1334.1, 4.1, 3],
  [787.6, 424.9, 2.2], [79.1, 372.6, 1.5], [559.8, 5.3, 1.5], [1153.2, 405.4, 1.5], [822.6, 313.3, 1.5],
  [581.1, 21.4, 1.5], [266.6, 478.5, 2.2], [1008.6, 139.6, 1.5], [9.5, 108.1, 1.5], [44.4, 464.7, 1.5],
] as const;
const sparkles = [[1395.5, 35.5, 9], [516, 436, 8]] as const;
const features = [
  ['Live cursors', 'See who is looking at which slide.', 1200],
  ['Follow mode', 'Jump along with whoever presents.', 1320],
  ['Invites', 'Bring your team in by mail or link.', 1440],
] as const;
const crew = [
  { name: 'Neven', x: 633.1, y: 54.4 },
  { name: 'Lara', x: 669.1, y: 276.9 },
  { name: 'Marlon', x: 503.6, y: 288 },
] as const;
---

<section class="relative isolate overflow-hidden px-4 py-12 md:px-16 lg:h-[495px] lg:pt-20 lg:pb-0" data-section>
  <Motion />
  <Stars stars={stars} height={495} sparkles={sparkles} />
  <div
    class="pointer-events-none absolute top-[37.5px] left-[calc(50%-60px)] -z-10 h-[360px] w-[900px]"
    style="background: radial-gradient(closest-side, rgb(143 203 155 / 0.1), rgb(143 203 155 / 0)); --d: 300ms; --y: 0px"
    data-hb
    aria-hidden="true"
  ></div>

  <!-- The crew orbiting the deck (centred on the page). -->
  <div class="pointer-events-none absolute top-0 left-1/2 -z-10 hidden h-[495px] w-[1440px] -translate-x-1/2 md:block" aria-hidden="true">
    <img src={img('tick-ring.png')} alt="" class="absolute top-[-80px] left-[460px] size-[560px]" />
    <img src={img('orbit-03.svg')} alt="" class="absolute top-[-50px] left-[490px] size-[500px]" />
    <img src={img('orbit-02.png')} alt="" class="absolute top-[25px] left-[565px] size-[350px]" />
    <img src={img('orbit-01.svg')} alt="" class="absolute top-[95px] left-[635px] size-[210px]" />
    <div class="absolute top-[25px] left-[565px] size-[350px]">
      <div class="absolute inset-[-2.86%_11.79%_82.09%_17.75%]">
        <img src={img('trajectory.svg')} alt="" class="block size-full max-w-none" />
      </div>
    </div>
    <div class="absolute top-[183px] left-[717px] h-[34px] w-[46px]">
      <div class="absolute top-0 left-0 h-[23px] w-[34px] rounded-thumb bg-fg-faint"></div>
      <div class="absolute top-[11px] left-3 h-[23px] w-[34px] rounded-thumb bg-sage shadow-[0_0_28px_var(--color-sage-glow)]"></div>
    </div>
    {
      crew.map(({ name, x, y }, i) => (
        <>
          <span
            class="absolute size-2 rounded-full"
            style={`left: ${x}px; top: ${y}px; background: ${i === 0 ? 'var(--color-sage)' : 'var(--color-fg)'}; ${i === 0 ? 'box-shadow: 0 0 10px var(--color-sage-glow)' : ''}`}
          />
          <Cursor
            name={name}
            drift
            class="absolute"
            style={`left: ${x + 10}px; top: ${y + 8}px; --drift-t: ${6 + i}s; --drift-d: ${-i * 1.7}s; --drift-x: ${i % 2 ? -5 : 6}px`}
          />
        </>
      ))
    }
  </div>

  <div class="relative mx-auto flex max-w-[1312px] flex-col gap-10 lg:flex-row lg:items-start lg:justify-between">
    <div class="flex flex-col gap-5 pt-[7px]">
      <SectionMark label="Live" />
      <h2 class="text-[40px] leading-[1.12] font-bold tracking-[-0.03em] text-fg sm:text-[56px]">
        <span class="block" data-hb="words" style="--d: 0ms">Review <Highlight by="Anna">together</Highlight></span>
        <span class="block" data-hb="words" style="--d: 125ms">in real time.</span>
      </h2>
    </div>

    <div class="flex w-full max-w-[452px] flex-col gap-3.5">
      <div class="flex flex-wrap items-center gap-4">
        <div class="flex items-center gap-2.5" data-hb style="--d: 1600ms; --y: 18px">
          <span class="flex items-center gap-1.5">
            <AvatarStack authors={others} size={32} max={3} />
            <Avatar author={person('Gesa')} size={32} nativeTitle={false} />
          </span>
          <span class="size-2 rounded-full bg-success shadow-[0_0_8px_var(--color-success)]"></span>
          <span class="text-body font-medium text-fg-muted">4 people here</span>
        </div>
        <span data-hb style="--d: 1870ms; --y: 18px">
          <Tag label="You are following Finnja" accent={accentColor(person('Finnja').color)} />
        </span>
      </div>
      <div class="flex flex-col gap-3 overflow-hidden rounded-panel bg-glass p-4 ring-hairline backdrop-blur-md" data-hb style="--d: 2050ms; --y: 18px">
        <p class="text-sm font-medium text-fg">Invite to workspace</p>
        <div class="flex items-center gap-2 rounded-control bg-surface-1 py-1 pr-1 pl-3 ring-hairline">
          <span class="min-w-0 flex-1 truncate text-body text-fg-muted">slider.bertro.dev/join/k7f2q9</span>
          <span class={buttonClasses({ variant: 'secondary', size: 'md' })}>Copy link</span>
        </div>
        <p class="text-xs text-fg-subtle">Reviewers view and comment, members also upload decks.</p>
      </div>
    </div>
  </div>

  <div class="relative mx-auto mt-12 grid max-w-[1312px] gap-8 sm:grid-cols-3 lg:mt-14">
    {
      features.map(([title, body, d]) => (
        <div class="flex flex-col gap-2 border-t border-hairline-strong pt-4" data-hb style={`--d: ${d}ms; --y: 20px`}>
          <h3 class="flex items-center gap-2 text-base font-semibold text-fg">
            <span class="size-2 rounded-full bg-sage shadow-[0_0_10px_var(--color-sage-glow)]" />
            {title}
          </h3>
          <p class="text-sm leading-normal text-fg-subtle">{body}</p>
        </div>
      ))
    }
  </div>
</section>
