---
import SectionMark from '~/components/SectionMark.astro';
import { asset } from '~/lib/links';
import markCircleSvg from '../../../public/home-b/motion/mark-circle.svg?raw';
import Motion from './b/Motion.astro';
import Stars from './b/Stars.astro';
import Variants from './b/Variants.astro';

/**
 * Homepage | In the works: web-native slides. A live slide plays its steps in a loop (title
 * rises, bars grow with an 80 ms stagger, Q4 glows) while its thread disagrees on it; one click
 * has the AI draft a slide per opinion, branching off the deck above and below (see Variants).
 */
const img = (name: string) => asset(`home-b/motion/${name}`);
// The hand-drawn circle draws itself once the section is in view.
const markCircle = markCircleSvg
  .replace(/style="[^"]*"/, '')
  .replace(/width="[^"]*" height="[^"]*"/, 'width="100%" height="100%" aria-hidden="true"')
  .replace('<path ', '<path pathLength="1" data-draw style="--i: 4" ');
const stars = [
  [1008.7, 517.7, 1.5], [587.5, 563.8, 1.5], [454.1, 315.3, 1.5], [956.2, 39.3, 1.5], [63.5, 109.5, 1.5],
  [1199.3, 122.6, 1.5], [86.3, 537.4, 2.2], [1357.5, 584.2, 2.2], [1056.9, 306.3, 2.2], [1230.9, 90.2, 2.2],
  [712, 21.7, 1.5], [1068.2, 517.7, 1.5], [1154.7, 297.3, 2.2], [657.1, 299.1, 1.5], [43.8, 295.9, 1.5],
  [1149.1, 321.7, 2.2], [338.8, 480.3, 1.5], [605.8, 405.4, 1.5], [178.5, 239.6, 1.5], [157.5, 491.8, 1.5],
  [581, 355.9, 1.5], [812.3, 1.2, 1.5], [651.7, 432, 1.5], [670.2, 265.4, 2.2], [550.9, 126.5, 1.5],
  [1098.6, 169.5, 2.2], [372.4, 528.1, 1.5], [1198.8, 528.6, 1.5], [714.4, 126.7, 1.5], [550.2, 471.8, 1.5],
  [97.1, 504, 1.5], [457.7, 252, 2.2], [875, 354.7, 1.5], [843.4, 224.6, 2.2], [1288.1, 133, 1.5],
  [99.5, 417.4, 2.2], [26, 76, 1.5], [14.8, 79.7, 2.2], [225.7, 355.9, 1.5], [801.5, 159, 1.5],
] as const;
const sparkles = [[1295, 115, 10], [156, 976, 8], [1325.5, 1245.5, 9]] as const;
const facts = ['Steps, not click animations', 'Transitions that carry the story', 'Opinions become drafts'];
---

<section class="relative isolate overflow-hidden px-4 py-12 md:px-16 lg:py-16" data-section>
  <Motion />
  <Stars stars={stars} height={1686} sparkles={sparkles} />

  <!-- Orbit map: three faint arcs, a tick arc and the sage trajectory arriving top left. -->
  <div class="pointer-events-none absolute top-0 left-1/2 -z-10 h-[1686px] w-[1440px] -translate-x-1/2" aria-hidden="true">
    {
      [
        ['r560.svg', 160, 450, 1120],
        ['r690.png', 30, 320, 1380],
        ['r820.svg', -100, 190, 1640],
      ].map(([src, x, y, size]) => (
        <div class="absolute" style={`left: ${x}px; top: ${y}px; width: ${size}px; height: ${size}px`}>
          <img src={img(src as string)} alt="" class="absolute inset-[0_0.62%_57.81%_0.62%] block h-[42.19%] w-[98.76%] max-w-none" />
        </div>
      ))
    }
    <div class="absolute top-[320px] left-[30px] size-[1380px]">
      <img src={img('tick-arc.png')} alt="" class="absolute top-[7.78%] left-[3.51%] h-[24%] w-[19.97%] max-w-none" />
    </div>
    <div class="absolute top-[190px] left-[-100px] size-[1640px]">
      <div class="absolute inset-[17.64%_87.97%_61.92%_1.08%]">
        <img src={img('trajectory.svg')} alt="" class="block size-full max-w-none" />
      </div>
    </div>
    <div class="absolute top-[482.8px] left-[83.7px] size-[9px]">
      <div class="absolute inset-[-155.56%]"><img src={img('sat-arrival.svg')} alt="" class="block size-full max-w-none" /></div>
    </div>
    <img src={img('sat-launch.svg')} alt="" class="absolute top-[518.6px] left-[1204.4px] size-[7px]" />
  </div>

  <!-- Header -->
  <div class="relative mx-auto flex max-w-[926px] flex-col items-center gap-5 text-center">
    <SectionMark label="In the works" accent="var(--color-accent-blue)" />
    <h2 class="text-[44px] leading-[1.04] font-bold tracking-[-0.04em] text-fg sm:text-[72px] lg:text-[96px]">
      <span class="block whitespace-nowrap" data-hb="words" style="--d: 0ms">
        That's the <span class="relative inline-block px-[0.12em] text-white">future<span class="ms-circle pointer-events-none absolute top-[-4%] left-[-4.4%] h-[116%] w-[108%]">
            <Fragment set:html={markCircle} />
          </span></span>
      </span>
      <span class="block whitespace-nowrap" data-hb="words" style="--d: 150ms">of presentations.</span>
    </h2>
    <p class="max-w-[760px] text-lg leading-[1.55] text-fg-muted sm:text-xl" data-hb style="--d: 500ms; --y: 24px">
      Slides built for the web: steps, smooth transitions, editable by people and AI.
    </p>
    <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2" data-hb style="--d: 700ms; --y: 16px">
      {
        facts.map((fact) => (
          <li class="flex items-center gap-2 text-sm font-medium text-fg-muted">
            <span class="size-1.5 rounded-full bg-sage shadow-[0_0_8px_var(--color-sage-glow)]" />
            {fact}
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Playground: three opinions on the live slide, the AI drafts one slide each. -->
  <div class="relative mx-auto mt-10 max-w-[1312px] lg:mt-12" data-hb style="--d: 400ms">
    <Variants />
  </div>
</section>

<style is:global>
  /*
   * One loop of the live slide (4.8 s): 0–0.6 s title rises, 0.35–1.1 s bars and their values
   * grow (80 ms stagger), 0.9–1.6 s Q4 glows, then it holds and resets. Only runs while motion is
   * allowed and once the section is in view; otherwise the final step shows.
   */
  @property --ms-step {
    syntax: '<integer>';
    inherits: true;
    initial-value: 3;
  }

  @media (prefers-reduced-motion: no-preference) {
    .js .is-in .ms-live .ms-title {
      animation: ms-title 4.8s var(--ease-emphasized) infinite;
    }
    .js .is-in .ms-live .ms-trail {
      animation: ms-fade 4.8s linear infinite;
    }
    .js .is-in .ms-live .ms-bar {
      animation: ms-bar 4.8s var(--ease-emphasized) infinite;
      animation-delay: calc(var(--i) * 80ms);
    }
    .js .is-in .ms-live .ms-val {
      animation: ms-val 4.8s var(--ease-emphasized) infinite;
      animation-delay: calc(var(--i) * 80ms);
    }
    .js .is-in .ms-live .ms-q4 {
      animation:
        ms-bar 4.8s var(--ease-emphasized) infinite calc(var(--i) * 80ms),
        ms-glow 4.8s var(--ease-emphasized) infinite;
    }
    @supports (width: calc(mod(5px, 3px))) {
      .ms-step {
        font-size: 0;
      }
      .ms-step::after {
        font-size: 12px;
        counter-reset: step var(--ms-step);
        content: 'Step ' counter(step) ' / 3';
      }
      .js .is-in .ms-live {
        animation: ms-steps 4.8s step-end infinite;
      }
    }
  }

  .ms-live .ms-q4 {
    box-shadow:
      0 0 100px rgb(0 72 255 / 0.5),
      0 0 40px rgb(0 72 255 / 0.9);
  }

  @keyframes ms-title {
    0% {
      opacity: 0;
      translate: 0 32px;
    }
    12.5%,
    92% {
      opacity: 1;
      translate: 0 0;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes ms-fade {
    0%,
    6% {
      opacity: 0;
    }
    14%,
    92% {
      opacity: 0.14;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes ms-bar {
    0%,
    7% {
      scale: 1 0;
    }
    18%,
    92% {
      scale: 1 1;
    }
    100% {
      scale: 1 0;
    }
  }
  @keyframes ms-val {
    0%,
    14% {
      opacity: 0;
    }
    20%,
    92% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes ms-glow {
    0%,
    19% {
      box-shadow: 0 0 0 rgb(0 72 255 / 0);
    }
    33%,
    92% {
      box-shadow:
        0 0 100px rgb(0 72 255 / 0.5),
        0 0 40px rgb(0 72 255 / 0.9);
    }
    100% {
      box-shadow: 0 0 0 rgb(0 72 255 / 0);
    }
  }
  @keyframes ms-steps {
    0% {
      --ms-step: 1;
    }
    7% {
      --ms-step: 2;
    }
    19% {
      --ms-step: 3;
    }
  }
</style>
