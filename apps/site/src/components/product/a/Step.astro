---
import Tag from '~/components/Tag.astro';

/** One numbered step under a product flow: tag, title, one line of copy. */
interface Props {
  n: number;
  title: string;
  body: string;
}

const { n, title, body } = Astro.props;
---

<div class="flex flex-col items-start gap-2" data-reveal style={`--i: ${10 + n}`}>
  <Tag label={`Step ${n}`} accent="#fff" />
  <p class="text-[22px] font-semibold tracking-[-0.01em] text-fg">{title}</p>
  <p class="max-w-[400px] text-[15px] leading-[22px] text-fg-muted">{body}</p>
</div>
