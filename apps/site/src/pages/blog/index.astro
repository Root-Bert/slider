---
import Cover from '~/components/blog/Cover.astro';
import PostCard from '~/components/blog/PostCard.astro';
import PostMeta from '~/components/blog/PostMeta.astro';
import { publishedPosts } from '~/components/blog/posts';
import Base from '~/layouts/Base.astro';
import { CONTACT_URL, page } from '~/lib/links';

const posts = await publishedPosts();
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const rest = posts.filter((post) => post !== featured);
const filters = [
  ['all', 'All'],
  ['comparison', 'Comparisons'],
  ['customer-story', 'Customer stories'],
  ['update', 'Updates'],
  ['guide', 'Guides'],
] as const;
---

<Base
  current="blog"
  title="Blog"
  description="How Slider compares to the tools you know, how teams review their decks and what we shipped this month."
>
  <section class="bl" data-section>
    <p class="bl-kind" data-reveal>Blog</p>
    <h1 class="bl-title" data-reveal style="--i: 1">Notes on getting ideas across.</h1>
    <p class="bl-sub" data-reveal style="--i: 2">
      How Slider compares to the tools you know, how teams review their decks and what we shipped this month.
    </p>
    <div class="bl-tools" data-reveal style="--i: 3">
      <div class="bl-filters" role="group" aria-label="Filter articles">
        {
          filters.map(([key, label]) => (
            <button type="button" data-filter={key} aria-pressed={key === 'all' ? 'true' : 'false'}>
              {label}
            </button>
          ))
        }
      </div>
      <label class="bl-search focus-field">
        <span aria-hidden="true">⌕</span>
        <span class="sr-only">Search articles</span>
        <input type="search" data-search placeholder="Search articles" />
      </label>
    </div>
  </section>

  {
    featured && (
      <section class="bl" data-section>
        <a
          href={page(`blog/${featured.id}`)}
          class="bl-featured"
          data-reveal
          data-post
          data-tag={featured.data.tag.toLowerCase().replace(/\s+/g, '-')}
          data-text={`${featured.data.title} ${featured.data.description}`.toLowerCase()}
        >
          <Cover post={featured} size="wide" />
          <div class="bl-featured-text">
            <PostMeta post={featured} />
            <h2>{featured.data.title}</h2>
            <p>{featured.data.description}</p>
            <span class="bl-more">{featured.data.tag === 'Comparison' ? 'Read the comparison' : 'Read the article'} <span aria-hidden="true">→</span></span>
          </div>
        </a>
      </section>
    )
  }

  <section class="bl" data-section>
    <div class="bl-grid">
      {rest.map((post, i) => <PostCard post={post} index={i} />)}
      <a
        href={`${CONTACT_URL}?subject=${encodeURIComponent('Our Slider story')}`}
        class="bl-open"
        data-reveal
        data-post
        data-tag="customer-story"
        data-text="your team's story could be next using slider for your reviews? tell us how, and we will write it up together."
        style={`--i: ${rest.length}`}
      >
        <div class="bl-open-slide" aria-hidden="true">
          <span class="bl-open-quote">“</span>
          <span class="bub-cursor bl-open-you"><span>You?</span></span>
        </div>
        <div class="flex flex-col gap-3 pt-5">
          <div class="flex items-center gap-2.5">
            <span class="text-caption font-medium tracking-wide uppercase text-fg-muted">Customer story</span>
            <span class="text-xs tabular-nums text-fg-subtle">Open call</span>
          </div>
          <h3 class="text-xl leading-[1.3] font-semibold tracking-[-0.01em] text-fg">Your team's story could be next</h3>
          <p class="text-sm leading-[1.55] text-fg-subtle">Using Slider for your reviews? Tell us how, and we will write it up together.</p>
        </div>
      </a>
    </div>
    <p class="mt-10 hidden text-center text-sm text-fg-subtle" data-empty>No articles match yet.</p>
  </section>
</Base>

<style>
  .bl {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 32px;
  }
  .bl:first-of-type {
    padding-top: 120px;
  }
  .bl-kind {
    font-size: 17px;
    font-weight: 500;
    color: var(--color-fg-muted);
  }
  .bl-title {
    max-width: 10em;
    margin-top: 20px;
    font-size: clamp(44px, 5.6vw, 92px);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }
  .bl-sub {
    max-width: 32em;
    margin-top: 28px;
    font-size: 19px;
    line-height: 1.5;
    color: var(--color-fg-muted);
  }
  .bl-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin: 48px 0 56px;
  }
  .bl-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .bl-filters button {
    height: 40px;
    padding: 0 16px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-fg-muted);
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
    transition:
      color 150ms,
      background-color 150ms;
  }
  .bl-filters button:hover {
    color: var(--color-fg);
  }
  .bl-filters button[aria-pressed='true'] {
    background: var(--color-accent-blue);
    color: #fff;
    box-shadow: none;
  }
  .bl-search {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 280px;
    height: 40px;
    margin-left: auto;
    padding: 0 16px;
    border-radius: 999px;
    color: var(--color-fg-subtle);
    box-shadow: inset 0 0 0 1px var(--color-hairline-strong);
  }
  .bl-search input {
    width: 100%;
    background: transparent;
    font-size: 14px;
    color: var(--color-fg);
    outline: none;
  }
  .bl-search input::placeholder {
    color: var(--color-fg-subtle);
  }

  .bl-featured {
    display: grid;
    grid-template-columns: 7fr 5fr;
    align-items: center;
    gap: 56px;
  }
  .bl-featured-text {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .bl-featured h2 {
    font-size: clamp(28px, 2.8vw, 44px);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .bl-featured p {
    font-size: 17px;
    line-height: 1.55;
    color: var(--color-fg-muted);
  }
  .bl-more {
    font-size: 15px;
    font-weight: 600;
    color: var(--color-accent-blue);
  }
  .bl-more span {
    display: inline-block;
    transition: translate 200ms var(--ease-emphasized);
  }
  .bl-featured:hover .bl-more span {
    translate: 3px 0;
  }

  .bl-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 56px 32px;
    margin-top: 96px;
  }
  /* The open call: an empty slide waiting for your story, your cursor already on it. */
  .bl-open-slide {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 10;
    margin: 0 0 10px 10px;
    border: 2px dashed var(--color-hairline-strong);
    border-radius: 20px;
    transition: border-color 150ms;
  }
  .bl-open:hover .bl-open-slide {
    border-color: var(--color-accent-blue);
  }
  .bl-open-quote {
    font-size: 150px;
    font-weight: 800;
    line-height: 0.6;
    padding-top: 0.25em;
    color: var(--color-fg-faint);
  }
  .bl-open-you {
    --c: var(--color-accent-blue);
    --ink: #fff;
    position: absolute;
    top: 58%;
    left: 60%;
  }

  @media (max-width: 1023px) {
    .bl-featured {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
    .bl-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 767px) {
    .bl {
      padding: 0 16px;
    }
    .bl:first-of-type {
      padding-top: 72px;
    }
    .bl-search {
      width: 100%;
      margin-left: 0;
    }
    .bl-grid {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 72px;
    }
  }
</style>

<script>
  // Filter chips + search over the cards (all posts are on this one page).
  const cards = [...document.querySelectorAll<HTMLElement>('[data-post]')];
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const search = document.querySelector<HTMLInputElement>('[data-search]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  let tag = 'all';

  function apply() {
    const query = search?.value.trim().toLowerCase() ?? '';
    let shown = 0;
    for (const card of cards) {
      const match =
        (tag === 'all' || card.dataset.tag === tag) && (!query || card.dataset.text?.includes(query));
      card.hidden = !match;
      if (match) shown++;
    }
    empty?.classList.toggle('hidden', shown > 0);
  }

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      tag = chip.dataset.filter ?? 'all';
      for (const other of chips) other.setAttribute('aria-pressed', String(other === chip));
      apply();
    });
  }
  search?.addEventListener('input', apply);
</script>
