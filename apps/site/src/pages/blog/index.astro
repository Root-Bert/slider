---
import BlogOrbit from '~/components/blog/BlogOrbit.astro';
import Cover from '~/components/blog/Cover.astro';
import PostCard from '~/components/blog/PostCard.astro';
import PostMeta from '~/components/blog/PostMeta.astro';
import { publishedPosts } from '~/components/blog/posts';
import Highlight from '~/components/Highlight.astro';
import SectionMark from '~/components/SectionMark.astro';
import Starfield from '~/components/Starfield.astro';
import Base from '~/layouts/Base.astro';
import { CONTACT_URL, page } from '~/lib/links';

const posts = await publishedPosts();
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const rest = posts.filter((post) => post !== featured);
const filters = [
  ['all', 'All'],
  ['comparison', 'Comparisons'],
  ['customer-story', 'Customer stories'],
  ['update', 'Updates'],
  ['guide', 'Guides'],
] as const;
const words = (text: string) => text.split(' ');
---

<Base
  current="blog"
  title="Blog"
  description="How Slider compares to the tools you know, how teams review their decks and what we shipped this month."
>
  <section class="relative isolate px-4 pt-20 pb-12 md:px-16 md:pt-30" data-section>
    <BlogOrbit corner="right" />
    <Starfield src="blog/hero-starfield.svg" />
    <SectionMark label="Blog | Comparisons, stories and updates" accent="var(--color-accent-cyan)" />
    <h1 class="mt-6 text-[30px] sm:text-[40px] leading-[1.12] font-bold tracking-[-0.03em] text-fg md:text-[64px]">
      {words('Notes on').map((word, i) => <span class="inline-block" data-reveal style={`--i: ${i}`}>{word}&nbsp;</span>)}
      <Highlight by="Rose"><span class="inline-block" data-reveal style="--i: 2">getting ideas across.</span></Highlight>
    </h1>
    <p class="mt-6 max-w-[620px] text-[17px] leading-[1.55] text-fg-muted md:text-[19px]" data-reveal style="--i: 4">
      How Slider compares to the tools you know, how teams review their decks and what we shipped this month.
    </p>
    <div class="mt-6 flex flex-col gap-4 pt-4 lg:flex-row lg:items-center" data-reveal style="--i: 6">
      <div class="flex flex-wrap gap-2" role="group" aria-label="Filter articles">
        {
          filters.map(([key, label]) => (
            <button
              type="button"
              data-filter={key}
              aria-pressed={key === 'all' ? 'true' : 'false'}
              class="rounded-full px-4 py-2 text-sm font-medium text-fg-muted ring-hairline glass-control transition-colors hover:text-fg aria-pressed:bg-selected aria-pressed:text-fg"
            >
              {label}
            </button>
          ))
        }
      </div>
      <label class="flex h-10 w-full items-center gap-2.5 rounded-full px-4 text-fg-subtle ring-hairline glass-control focus-field lg:ml-auto lg:w-[280px]">
        <span aria-hidden="true" class="text-[15px]">⌕</span>
        <span class="sr-only">Search articles</span>
        <input
          type="search"
          data-search
          placeholder="Search articles"
          class="w-full bg-transparent text-sm text-fg outline-none placeholder:text-fg-subtle"
        />
      </label>
    </div>
  </section>

  {
    featured && (
      <section class="px-4 md:px-16" data-section>
        <a
          href={page(`blog/${featured.id}`)}
          class="group flex flex-col overflow-hidden rounded-[20px] bg-glass shadow-[0_0_60px_rgb(255_255_255/0.06)] ring-hairline transition-colors hover:bg-glass-hover lg:flex-row"
          data-reveal
          data-post
          data-tag={featured.data.tag.toLowerCase().replace(/\s+/g, '-')}
          data-text={`${featured.data.title} ${featured.data.description}`.toLowerCase()}
        >
          <Cover post={featured} size="wide" class="h-[260px]! shrink-0 lg:h-[400px]! lg:w-[720px]" />
          <div class="flex flex-1 flex-col justify-center gap-5 p-6 md:p-12">
            <PostMeta post={featured} />
            <h2 class="text-[26px] leading-[1.18] font-bold tracking-[-0.02em] text-fg md:text-[34px]">{featured.data.title}</h2>
            <p class="text-base leading-[1.55] text-fg-muted">{featured.data.description}</p>
            <span class="text-[15px] font-semibold whitespace-pre text-fg">{featured.data.tag === 'Comparison' ? 'Read the comparison' : 'Read the article'}  →</span>
          </div>
        </a>
      </section>
    )
  }

  <section class="relative isolate px-4 pt-12 md:px-16" data-section>
    <Starfield src="blog/posts-starfield.svg" />
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {rest.map((post, i) => <PostCard post={post} index={i} />)}
      <a
        href={`${CONTACT_URL}?subject=${encodeURIComponent('Our Slider story')}`}
        class="flex flex-col overflow-hidden rounded-[20px] border border-dashed border-hairline-strong bg-glass transition-colors hover:bg-glass-hover"
        data-reveal
        data-post
        data-tag="customer-story"
        data-text="your team's story could be next using slider for your reviews? tell us how, and we will write it up together."
        style={`--i: ${rest.length}`}
      >
        <div class="relative isolate flex h-[220px] items-center justify-center overflow-hidden bg-surface-1" aria-hidden="true">
          <img src={`${page('blog/glow-green.svg')}`} alt="" class="pointer-events-none absolute -z-10 h-[140%] w-[120%] max-w-none" />
          <span class="text-[150px] leading-none font-black text-sage [text-shadow:0_0_30px_rgb(143_203_155/0.4)]">“</span>
        </div>
        <div class="flex flex-col gap-3 px-6 pt-6 pb-7">
          <div class="flex items-center gap-2.5">
            <span class="inline-flex items-center rounded-badge bg-sage/15 px-2 py-[3px] text-caption font-medium tracking-wide uppercase text-sage uppercase">Customer story</span>
            <span class="text-xs tabular-nums text-fg-subtle">Open call</span>
          </div>
          <h3 class="text-xl leading-[1.3] font-semibold tracking-[-0.01em] text-fg">Your team's story could be next</h3>
          <p class="text-sm leading-[1.55] text-fg-subtle">Using Slider for your reviews? Tell us how, and we will write it up together.</p>
        </div>
      </a>
    </div>
    <p class="mt-10 hidden text-center text-sm text-fg-subtle" data-empty>No articles match yet.</p>
  </section>

</Base>

<script>
  // Filter chips + search over the cards (all posts are on this one page).
  const cards = [...document.querySelectorAll<HTMLElement>('[data-post]')];
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const search = document.querySelector<HTMLInputElement>('[data-search]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  let tag = 'all';

  function apply() {
    const query = search?.value.trim().toLowerCase() ?? '';
    let shown = 0;
    for (const card of cards) {
      const match =
        (tag === 'all' || card.dataset.tag === tag) && (!query || card.dataset.text?.includes(query));
      card.hidden = !match;
      if (match) shown++;
    }
    empty?.classList.toggle('hidden', shown > 0);
  }

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      tag = chip.dataset.filter ?? 'all';
      for (const other of chips) other.setAttribute('aria-pressed', String(other === chip));
      apply();
    });
  }
  search?.addEventListener('input', apply);
</script>
