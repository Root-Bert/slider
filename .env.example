# Copy to `.env` (never commit it). All values are optional for local development.

# ── API ──────────────────────────────────────────────────────────────────────
PORT=8787
# Where PGlite (database) and uploaded files live.
DATA_DIR=apps/api/.data
# Signs guest session cookies. Use a long random value in production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SLIDER_SECRET=
# Origin of the web app (CORS).
WEB_ORIGIN=http://localhost:5173

# ── Microsoft Graph (BER-88 / BER-92 – not wired up yet) ────────────────────
# Entra app registration "Slider", delegated scopes: Files.Read.All offline_access User.Read
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common
