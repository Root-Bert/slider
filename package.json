{
  "name": "slider",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Review PowerPoint decks precisely: mark, comment, version.",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "bun": ">=1.3",
    "node": ">=22"
  },
  "scripts": {
    "dev": "bun run --filter @slider/api --filter @slider/web dev",
    "dev:site": "bun run --filter @slider/site dev",
    "build": "bun run --filter '*' build",
    "start": "NODE_ENV=production bun apps/api/src/server.ts",
    "typecheck": "bun run --filter '*' typecheck && tsc -p e2e && tsc -p test",
    "test": "vitest run",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:bundle": "E2E_BUNDLE=1 playwright test -c e2e/playwright.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "seed": "bun run --filter @slider/api seed",
    "sample": "bun run --filter @slider/pptx sample"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
