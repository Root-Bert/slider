# Copy to deploy/authentik/.env (never commit it).
# Generate: openssl rand -base64 36 | tr -d '\n'
PG_PASS=
# Generate: openssl rand -base64 60 | tr -d '\n'
AUTHENTIK_SECRET_KEY=
AUTHENTIK_ERROR_REPORTING__ENABLED=false

# Optional: e-mail for password resets/invitations sent by Authentik.
# AUTHENTIK_EMAIL__HOST=smtp.example.com
# AUTHENTIK_EMAIL__PORT=587
# AUTHENTIK_EMAIL__USERNAME=
# AUTHENTIK_EMAIL__PASSWORD=
# AUTHENTIK_EMAIL__USE_TLS=true
# AUTHENTIK_EMAIL__FROM=auth@example.com

# Pinned version; update deliberately (read the release notes first).
# AUTHENTIK_TAG=2026.8.3

# Only with the shared Caddy of deploy/proxy (several apps per server): join its network.
# PROXY_NETWORK=web
