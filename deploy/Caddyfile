{
	servers {
		# Behind Cloudflare (orange cloud) every request arrives from a Cloudflare edge address.
		# Trusting exactly those (TRUSTED_PROXIES) lets {client_ip} be the visitor (CF-Connecting-IP),
		# so rate limits work per person. Without Cloudflare TRUSTED_PROXIES stays empty: nobody is
		# trusted and {client_ip} is the connection's own address. Never trust private ranges here:
		# Caddy is the edge, and Docker hands IPv6 visitors over from its bridge gateway (172.x, a
		# private address) – they could then pick any IP via these headers and dodge the rate
		# limits. See docs/self-hosting.md, "Proxy und Cloudflare".
		trusted_proxies static {$TRUSTED_PROXIES}
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
	# The calls' site below answers call.localhost while CALL_DOMAIN is unset (Caddy's own CA):
	# nothing to install into the container's trust store for that.
	skip_install_trust
}

# Automatic HTTPS (Let's Encrypt) for the Slider domain. DNS A/AAAA records must point at this
# server and ports 80 + 443 must be open before the first start.
# SLIDER_OLD_DOMAINS (optional, space-separated): addresses Slider had before, kept for old links,
# apps and AI apps while they move – their DNS must still point here.
{$SLIDER_DOMAIN} {$SLIDER_OLD_DOMAINS} {
	encode zstd gzip
	# On an old address a browser going to a page lands on the same page at the new one (308) –
	# under /api only when it goes there as a page (a download, a sign-in's way back): its cookie
	# is at the new one. Everything else is answered on the old address as before: the API's
	# callers and AI apps (/api, /.well-known), what an open page still loads, and the desktop
	# apps of before (Electron in the User-Agent) – their windows only take pages of the server
	# they signed in to. No Sec-Fetch-Mode (crawlers, old browsers) counts as a page.
	@moved {
		not host {$SLIDER_DOMAIN}
		method GET HEAD
		not header User-Agent *Electron/*
		not path /.well-known/*
		not {
			path /api/*
			not header Sec-Fetch-Mode navigate
		}
		not header_regexp Sec-Fetch-Mode ^(cors|no-cors|same-origin|websocket)$
	}
	redir @moved https://{$SLIDER_DOMAIN}{uri} 308
	# Slider sets its own security headers (HSTS, nosniff, …) and serves the web app itself.
	reverse_proxy slider:8787 {
		# Slider reads the right-most X-Forwarded-For entry (TRUST_PROXY=1): hand it the visitor.
		header_up X-Forwarded-For {client_ip}
	}
}

# Calls with many people (COMPOSE_PROFILES=call, CALL_DOMAIN in .env): LiveKit's signalling
# (wss) – the media goes to the server's own ports (docker-compose.yml). Its DNS record must be
# DNS-only (no proxy): the browsers reach LiveKit's ports at the same address, and the
# certificate got here is LiveKit's for TURN over TLS too (deploy/livekit/start.sh). Without
# CALL_DOMAIN the site is call.localhost, which no browser reaches from outside.
{$CALL_DOMAIN:call.localhost} {
	reverse_proxy livekit:7880
}

# Further sites on this server: put their *.caddy files into sites/.
import /etc/caddy/sites/*.caddy

# The product website, only mounted by docker-compose.website.yml (otherwise matches nothing).
import /etc/caddy/website/*.caddy
