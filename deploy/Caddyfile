{
	servers {
		# Behind Cloudflare (orange cloud) every request arrives from a Cloudflare edge address.
		# Trusting exactly those (TRUSTED_PROXIES) lets {client_ip} be the visitor (CF-Connecting-IP),
		# so rate limits work per person. Without Cloudflare TRUSTED_PROXIES stays empty: nobody is
		# trusted and {client_ip} is the connection's own address. Never trust private ranges here:
		# Caddy is the edge, and Docker hands IPv6 visitors over from its bridge gateway (172.x, a
		# private address) – they could then pick any IP via these headers and dodge the rate
		# limits. See docs/self-hosting.md, "Proxy und Cloudflare".
		trusted_proxies static {$TRUSTED_PROXIES}
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

# Automatic HTTPS (Let's Encrypt) for the Slider domain. DNS A/AAAA records must point at this
# server and ports 80 + 443 must be open before the first start.
{$SLIDER_DOMAIN} {
	encode zstd gzip
	# Slider sets its own security headers (HSTS, nosniff, …) and serves the web app itself.
	reverse_proxy slider:8787 {
		# Slider reads the right-most X-Forwarded-For entry (TRUST_PROXY=1): hand it the visitor.
		header_up X-Forwarded-For {client_ip}
	}
}

# Further sites on this server: put their *.caddy files into sites/.
import /etc/caddy/sites/*.caddy

# The product website, only mounted by docker-compose.website.yml (otherwise matches nothing).
import /etc/caddy/website/*.caddy
