{
  "appId": "dev.bertro.sender",
  "productName": "Sender",
  "artifactName": "Sender-${arch}.${ext}",
  "directories": {
    "output": "dist/sender"
  },
  "extraMetadata": {
    "name": "sender-desktop",
    "productName": "Sender",
    "main": "sender/main.mjs",
    "description": "Sender as a desktop app: your workspace's messages, with notifications, in a window of their own."
  },
  "files": [
    "sender/**",
    "!sender/builder.json",
    "tabbar/**",
    "tabs.mjs",
    "hosted.mjs",
    "package.json"
  ],
  "mac": {
    "category": "public.app-category.business",
    "target": ["dmg", "zip"],
    "hardenedRuntime": true,
    "entitlements": "entitlements.mac.plist",
    "entitlementsInherit": "entitlements.mac.plist",
    "notarize": true,
    "darkModeSupport": true,
    "extendInfo": {
      "NSMicrophoneUsageDescription": "Für Anrufe, Sprach- und Videokommentare und um mit der KI zu sprechen.",
      "NSCameraUsageDescription": "Für Videoanrufe und Videokommentare."
    },
    "icon": "sender/icon.png"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "category": "Network",
    "executableName": "sender",
    "icon": "sender/icon.png"
  },
  "electronFuses": {
    "runAsNode": false,
    "enableNodeOptionsEnvironmentVariable": false,
    "enableNodeCliInspectArguments": false,
    "onlyLoadAppFromAsar": true,
    "enableEmbeddedAsarIntegrityValidation": true,
    "resetAdHocDarwinSignature": true
  },
  "protocols": [
    {
      "name": "Sender",
      "schemes": ["slider-sender"]
    }
  ]
}
